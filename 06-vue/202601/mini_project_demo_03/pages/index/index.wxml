<!--index.wxml-->
<scroll-view class="scrollarea" scroll-y type="list">
  <button bind:tap="toObserver">前往数据监听</button>
  <button style="margin-top: 10px" bind:tap="toMovableView">前往拖拽页面</button>
    <view class="usermotto">
      <text class="user-motto">{{motto}}</text>
    </view>
  <my-component >
    <view slot="before">自定义组件插槽头部</view>
    <view slot="after">自定义组件插槽尾部</view>
  </my-component>
  <!-- 滚动组件 -->
  <text style="font-weight: bold;">滚动组件</text>
  <scroll-view
    class="scroll-box"
    scroll-y="{{true}}"
    scroll-into-view="{{id}}"
    scroll-with-animation
    refresher-enabled
    bindrefresherrefresh="handleFresh"
    refresher-triggered="{{triggered}}"
  >
    <view id="{{'target' + index}}" class="product" wx:for="{{list}}" wx:key="id">
      <view>
        商品名称: {{item.name}}
      </view>
      <view>
        商品价格：{{item.price}}
      </view>
    </view>
  </scroll-view>
</scroll-view>
