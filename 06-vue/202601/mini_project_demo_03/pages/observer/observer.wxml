<!--pages/observer/observer.wxml-->
<view class="container">
 <view class="product-container" wx:for="{{products}}" wx:key="name">
   <view class="product-name">
    {{item.name}}
   </view>
   <view class="product">
     <text>￥{{item.price}}</text>
     <view class="num-box">
       <text bindtap="handleChange" data-index="{{index}}" data-type="add" class="btns">+</text>
       <text>{{item.num}}</text>
       <text bindtap="handleChange" data-index="{{index}}" data-type="del" class="btns">-</text>
     </view>
   </view>
 </view>
 <view class="total-price">
   合计：{{totalPrice}}
 </view>
</view>