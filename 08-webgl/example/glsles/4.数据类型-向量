//着色器语言 矢量/向量
关键字              数据类型
vec2            二维向量,具有xy两个分量,分量是浮点型
vec3            三维向量,具有xyz三个分量,分量是浮点型
vec4            四维向量,具有xyzw四个分量,分量是浮点型
ivec2           二维分量,分量是整型数
ivec3           三维向量,分量是整型数
ivec4           四维分量,分量是整型数
bvec2           二维分量,分量是布尔值
bvec3           三维向量,分量是布尔值
bvec4           四维分量,分量是布尔值

//访问获取向量分量
向量vector          访问
第一个分量          vector.x
第二个分量          vector.y
第三个分量          vector.z
第四个分量          vector.w

//向量分量更多灵活写法
//声明一个三维向量变量,并赋值
vec3 v3 = vec3(10.0, 9.0, 3.0);
//声明一个二维向量
vec2 v2;
//提取向量v3的xy两个赋值给二维向量v2
v2 = v3.xy; //=> v2 = (10.0, 9.0)
//v3的x分量赋值给v2的x分量,v3的分量z分量赋值给v2的分量
v2 = v3.xz; // => v2 = (10.0, 3.0)
//获得yz分量
v2 = v3.yz; // => v2 = (9.0, 3.0)
//获得zx分量 v3的z分量赋值给v2的x分量，v3的x分量赋值给v2的y分量
v2 = v3.zx; // => v2 = (3.0, 10.0)  


//数学运算
//一个向量加一个数字，相当于每个分量加上该数字，注意向量分量是整型数还是浮点数，加上的数字保持数据类型一致
vec3 pos = vec3(1.0, 2.0, 3.0);
//pos值加1
pos = pos + 1.0; // pos = vec3(2.0, 3.0, 4.0)
//pos不改变,赋值给新的变量
vec3 pos2 = pos + 1.0;  //pos2 = vec3(3.0, 4.0, 5.0)