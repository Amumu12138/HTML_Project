<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<meta name="viewport"  content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no">
	<meta name="format-detection" content="telephone=no">
	<meta name="apple-mobile-web-app-capable" content="yes"/>
	<meta name="mobile-web-app-capable" content="yes"/>
	<meta name="full-screen" content="true"/>
	<meta name="screen-orientation" content="portrait"/>

	<title>游戏</title>

	<link href="/css/common.css" rel="stylesheet">
	<link href="/css/layout.css" rel="stylesheet">

	<script type="text/javascript" src="/js/jquery/jquery-1.9.1.min.js"></script>
	<script type="text/javascript" src="/js/jquery/jquery.md5.js"></script>
	<script type="text/javascript" src="/js/pj_api.js"></script>
	<script type="text/javascript" src="/js/pj_channel_sdk.js"></script>
	<script type="text/javascript" src="https://newh5.lequ.com/Public/h5/js/lq.js" ></script>

	<style type="text/css">
		html,body{
			width:100%;
			height:100%
		}
		body {
/*
			background: url(https://h5.infoxgame.com/images/duojiao_loading.png) no-repeat center top;
*/
			background-size: auto 100%;
		}
	</style>
	<script src="../../js/jquery/jquery.md5.js"></script>

</head>

<body>

<script type="text/javascript">
    $(function(){

    	//初始化渠道sdk
		pjChannelSdk.init(10870,"smxnh5_lqhy_sm_001","1.0.0");
		console.info("初始化sdk成功......");
		//获取游戏信息
		pjChannelSdk.getGameInfo(function (retData) {
            console.info("getGameInfo return params +++"+JSON.stringify(retData));
			if(retData.code ==1){
				var gameName = retData.data.gameName;
				$(document).attr("title",gameName);
				var gameUrl = retData.data.gameUrl;
                var orientation = retData.data.orientation;

				//模拟渠道登录成功/ 真实的渠道，这里是初始化渠道sdk、获取渠道登录回调信息登录
				//初始化渠道sdk{
                var _params = pjapi.getURLParams();
					//var channelUserToken = "IGuWB9uTVqYumZTXH8Bg14fVX5fazMZt";//渠道用户token

					//不同的渠道使用不同的拼接方式,示例使用泡椒h5sdk
					var extension = JSON.stringify({"gameid":_params.gameid,
						"serverid":_params.serverid,"uid":_params.uid,
                        "fcm":_params.fcm,"time":_params.time,"sign":_params.sign});
					console.info("--------request params--------:"+extension);

					//校验渠道token
					pjChannelSdk.getToken(extension,function (retData) {
						if(retData.code == 1){
							var gameParam = {};
							gameParam["uid"] = retData.data.userInfo.uid;
							gameParam["sdkToken"] = retData.data.userInfo.token;

							gameUrl = pjapi.buildURL(gameUrl,gameParam);

							console.log("===进入游戏===>>"+gameUrl);
							 if(orientation == 0){//横屏游戏
                                  $("body").append('<div id="gameFrameDiv" style="width: 100%; height: 100%; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' + gameUrl + '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: 100%; height: 100%;"></iframe></div>');
                                  window.onorientationchange = function () {
                                      if (window.orientation == 90 || window.orientation == -90) {
                                          $("#gameFrameDiv").css({"left": $(window).width() - 20, "top": "30%"});
                                      }
                                  }
                              }else{//竖屏游戏
                                  $("body").append('<div id="gameFrameDiv" style="width: ' + $(window).width() + 'px;  height: ' + $(window).height() + 'px; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' + gameUrl + '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: ' + $(window).width() + 'px; height: ' + $(window).height() + 'px;"></iframe></div>');
                              }

						}else{
							pjapi.confirmDialog(retData.msg);
						}
					});

				//开启监听事件
				pjChannelSdk.startEventListener();

			}else{
				pjapi.confirmDialog(retData.msg);
                return;
			}

		});

    });

    function  receiveMessage(event){
		console.log(event.data);
		var params = event.data.param;

		if(event.data.method == 'PJ_loadPayBox'){//拉起支付
			console.log("调用订单获取接口");
			var payParam ={};

			payParam["channelGameId"]= pjChannelSdk.initData.channelGameId;
			payParam["appVersion"]= pjChannelSdk.initData.appVersion;
			payParam["channel"]=pjChannelSdk.initData.channel;
			payParam["sdkVersion"]=pjChannelSdk.sdkVersion;

			payParam["money"]=params["money"];
			payParam["uid"]=params["uid"];
			payParam["productName"]=params["goodsName"];
			payParam["roleId"]=params["roleId"];
			payParam["roleName"]=params["roleName"];
			payParam["serverId"]=params["serverId"];
			payParam["serverName"]=params["serverName"];
			payParam["description"]=params["description"];
			payParam["ext"]=params["ext"];
			payParam["cpOrderNo"]=params["cpOrderNo"];
			//生成融合sdk订单
			pjChannelSdk.getOrderNo(payParam,function (retData) {
                 if(retData.code == 1){
					 console.log("------获取订单成功-----:"+JSON.stringify(retData));
					 if(retData.data.payUrl){
						 var payUrl = retData.data.payUrl;

						 if(pjapi.isWeixin()){ //微信浏览器内使用iframe加载，拉不起公众号支付。
							 window.location.href= payUrl;
						 }else{
							 var payBox = '<div id="payBox" style="top:0px;" class="mask2 login-box2">';
							 payBox += '<div class="r5" style="margin:0 auto;top:0px;-webkit-border-radius:0px;border-radius:0px;">';
							 payBox += '<div class="login-head2"  style="text-align: right;"><span><i class="icon-cancel" onclick="pjChannelSdk.closePayBox()"></i></span></div>';
							 payBox += '<div class="login-body" style="height:'+($(window).height()-40)+'px !important;-webkit-overflow-scrolling: touch; overflow-y: scroll;">';
							 payBox += '<iframe  width="'+$(window).width()+'px !important" frameborder="no" scrolling="yes" border="0px" height="400px;"   src="'+payUrl+'"></iframe>';
							 payBox += '</div>';
							 payBox += '</div>';
							 payBox += '</div>';
							 $("body").append(payBox);
						 }

					 }else{
					     //sign 为 游戏ID+appKey 进行签名
					    var sign =$.md5("85657bfd1ff6e436f1aca41b534dd751c62");
                         var data = {
                             action: "pay",			//固定值 pay
                             uid: retData.data.orderInfo.sdkUserId,			// 登录用户id
                             gameid: "856",				// 游戏id
                             amount: retData.data.orderInfo.money,				// 订单金额（单位：元）
                             title: retData.data.orderInfo.goodsName,	// 充值标题
                             unit: '乐趣币',				// 充值单位，例如元宝
                             rate: '10',				    // 充值比例，例如1:10，填10
                             sign: sign, // 加密串
                             goodid: 1,						// 游戏方透传产品id
                             ext: retData.data.orderInfo.orderNumber				// 游戏方透传附加参数
                         };
                         console.info("request lequ pay params----:"+JSON.stringify(data));
                         lq.pay(data);
					 }
				 }else{
					 pjapi.confirmDialog(retData.msg);
				 }

			});
        }else if(event.data.method == 'PJ_reportRoleInfo'){//上报角色信息
            console.info("------------params----------"+JSON.stringify(params));
            console.info("-------调用渠道角色上报接口--------");
           /* var timestamp = pjapi.getTimestamp();
            var signStr = "856."+params.serverId+"."+""
            var signStr =$.md5("856.")
		    var  data = {
                action: 'levelup',		// 新建角色 'createrole' 升级 'levelup' 选择服务器进入时 'enterserver'
                gameid: 856,		    // 游戏id 参与签名
                serverid: params.serverId,		    // 区服id 参与签名
                servername:params.serverName,	    // 区服名称
                roleid:params.roleServer,				// 区服ID 参与签名
                rolename: params.roleName,		// 游戏角色名
                rolelevel:params.roleLever,	        // 用户等级 参与签名
                round: 0,	            //用户转生等级，必须为数字，若无，传入0 参与签名
                balance: 0,	        //用户游戏币余额，必须为数字，若无，传入0
                vip: 0,	            //当前用户VIP等级，必须为数字，若无，传入0
                partyname: '无帮派',	//当前角色所属帮派，不能为空，不能为null，若无，传入“无帮派”
                time: timestamp ,	// 时间戳 参与签名
                sign: "b599bda3fb53f5e439a3b5a3eae1460f",	// 签名
            };
            lq.roleinfo(data);
*/

        }
    }

</script>
</body>
</html>
