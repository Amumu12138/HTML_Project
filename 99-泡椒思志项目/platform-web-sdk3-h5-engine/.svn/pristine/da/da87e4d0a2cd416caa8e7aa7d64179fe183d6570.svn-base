<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="full-screen" content="true" />
    <meta name="screen-orientation" content="portrait" />

    <title>游戏</title>

    <link href="/css/common.css" rel="stylesheet">
    <link href="/css//layout.css" rel="stylesheet">

    <script type="text/javascript" src="/js/jquery/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="/js/jquery/jquery.md5.js"></script>
    <script type="text/javascript" src="/js/pj_api.js"></script>
    <script type="text/javascript" src="/js/pj_channel_sdk.js"></script>
    <style type="text/css">
        html,
        body {
            width: 100%;
            height: 100%
        }

        body {
            background: url(https://h5.paojiao.cn/images/qutoutiao/qtt_login_page.png) no-repeat center top;
            background-size: auto 100%;
        }

        #qtt_loading_img {
            position: fixed;
            z-index: 9999;
            width: 100%;
            height: 100%;
            left: 0;
            top: 0;
            /* background: rgba(0, 0, 0, .8); */
            /*background: url(https://h5.paojiao.cn/images/qutoutiao/qtt_loading_flash_xdhmy.png) 0 0/100% 100% no-repeat;*/
        }
    </style>
    <script src="../../js/jquery/jquery.md5.js"></script>

</head>

<body>
    <!--<img id="qtt_loading_img">-->

    <script type="text/javascript">
        $(function () {
            //初始化渠道sdk
            pjChannelSdk.init(10970, "smxnh5_bjaqyy_xh_001", "1.0.0");
            console.info("初始化sdk成功......");

            //获取游戏信息
            pjChannelSdk.getGameInfo(function (retData) {
                console.info("getGameInfo return params +++" + JSON.stringify(retData));
                if (retData.code == 1) {
                    var gameName = retData.data.gameName;
                    $(document).attr("title", gameName);
                    var gameUrl = retData.data.gameUrl;
                    var orientation = retData.data.orientation;

                    //初始化渠道sdk{
                    var _params = pjapi.getURLParams();
                    console.info("--------_params--------:" + JSON.stringify(_params));
                    //不同的渠道使用不同的拼接方式
                    var extension = JSON.stringify({
                        "user_id": _params.user_id, //用户id
                        "agent": _params.agent, //固定为pps
                        "time": _params.time, //Linux时间戳
                        "sign": _params.sign //签名
                    });
                    //保存渠道用户信息
                    pjChannelSdk["sdkUserId"] = _params.user_id;

                    console.info("--------reuqest params--------:" + extension);

                    //开始游戏页展示
                    var serverObj = {
                        type: 'dataCount',
                        msg: 'server'
                    }
                    window.top.postMessage(serverObj, '*');
                    //校验渠道token
                    pjChannelSdk.getToken(extension, function (retData) {
                        console.info("getToken return params-------：" + JSON.stringify(
                            retData));
                        if (retData.code == 1) {
                            var gameParam = {};
                            gameParam["uid"] = retData.data.userInfo.uid;
                            gameParam["sdkToken"] = retData.data.userInfo.token;
                            gameUrl = pjapi.buildURL(gameUrl, gameParam);

                            console.log("===进入游戏===>>" + gameUrl);
                            if (orientation == 0) { //横屏游戏
                                $("body").append(
                                    '<div id="gameFrameDiv" style="width: 100%; height: 100%; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' +
                                    gameUrl +
                                    '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: 100%; height: 100%;"></iframe></div>'
                                );
                                window.onorientationchange = function () {
                                    if (window.orientation == 90 || window.orientation == -
                                        90) {
                                        $("#gameFrameDiv").css({
                                            "left": $(window).width() - 20,
                                            "top": "30%"
                                        });
                                    }
                                }
                            } else { //竖屏游戏
                                $("body").append('<div id="gameFrameDiv" style="width: ' + $(
                                        window).width() + 'px;  height: ' + $(window)
                                    .height() +
                                    'px; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' +
                                    gameUrl +
                                    '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: ' +
                                    $(window).width() + 'px; height: ' + $(window)
                                    .height() + 'px;"></iframe></div>');
                            }
                        } else {
                            pjapi.confirmDialog(retData.msg);
                        }
                    });
                    //开启监听事件
                    pjChannelSdk.startEventListener();

                } else {
                    pjapi.confirmDialog(retData.msg);
                    return;
                }
            });
        });

        function receiveMessage(event) {
            console.log(event.data);
            var params = event.data.param;

            if (event.data.method == 'PJ_loadPayBox') { //拉起支付
                console.log("调用订单获取接口");
                var payParam = {};

                payParam["channelGameId"] = pjChannelSdk.initData.channelGameId;
                payParam["appVersion"] = pjChannelSdk.initData.appVersion;
                payParam["channel"] = pjChannelSdk.initData.channel;
                payParam["sdkVersion"] = pjChannelSdk.sdkVersion;
                //渠道需要签名时的参数
                payParam["sdkUserId"] = pjChannelSdk.sdkUserId;

                payParam["money"] = params["money"];
                payParam["uid"] = params["uid"];
                payParam["productName"] = params["goodsName"];
                payParam["roleId"] = params["roleId"];
                payParam["roleName"] = params["roleName"];
                payParam["serverId"] = params["serverId"];
                payParam["serverName"] = params["serverName"];
                payParam["description"] = params["description"];
                payParam["ext"] = params["ext"];
                payParam["cpOrderNo"] = params["cpOrderNo"];

                console.log("------------payParam--------------" + JSON.stringify(payParam));
                //生成融合sdk订单
                pjChannelSdk.getOrderNo(payParam, function (retData) {
                    if (retData.code == 1) {
                        console.log("获取订单成功：" + JSON.stringify(retData));

                        var game_id = '10309'; //游戏id
                        var user_id = pjChannelSdk.sdkUserId; //用户id
                        var server_id = retData.data.orderInfo.serverId; //服务器Id
                        var money = retData.data.orderInfo.money; //充值金额，单位元
                        var extra_param = retData.data.orderInfo.orderNumber; //扩展参数，可留空
                        var IQYPayUrl = 'game_id=' + game_id + '&user_id=' + user_id + '&server_id=' +
                            server_id + '&money=' + money + '&extra_param=' + extra_param;

                        console.log("------------IQYPayUrl--------------", IQYPayUrl);
                        window.parent.postMessage(IQYPayUrl, 'https://togame.iqiyi.com');
                    } else {
                        pjapi.confirmDialog(retData.msg);
                    }
                });
            } else if (event.data.method == 'PJ_reportRoleInfo') { //上报角色信息
                console.log("调用上报角色信息接口");
                var roleType = params["roleType"];

                if (roleType == 1) {
                    //上报类型为进入游戏
                    var startObj = {
                        type: 'dataCount',
                        msg: 'start'
                    }
                    window.top.postMessage(startObj, '*');
                } else if (roleType == 2) {
                    //上报类型为创建角色
                    var roleObj = {
                        type: 'dataCount',
                        msg: 'role'
                    }
                    window.top.postMessage(roleObj, '*');
                }
            }
        }
    </script>
</body>

</html>