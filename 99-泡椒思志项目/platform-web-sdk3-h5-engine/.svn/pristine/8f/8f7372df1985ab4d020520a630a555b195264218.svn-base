<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport"
          content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="mobile-web-app-capable" content="yes"/>
    <meta name="full-screen" content="true"/>
    <meta name="screen-orientation" content="portrait"/>
    <!--不缓存-->
    <!--<meta http-equiv="pragma" content="no-cache"/>
    <meta http-equiv="Cache-Control" content="no-cache, must-revalidate"/>
    <meta http-equiv="expires" content="0"/>
-->
    <title>游戏</title>

    <link href="/css/common.css" rel="stylesheet">
    <link href="/css/layout.css" rel="stylesheet">

    <script type="text/javascript" src="/js/jquery/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="/js/jquery/jquery.md5.js"></script>
    <script type="text/javascript" src="/js/pj_api.js"></script>
    <script type="text/javascript" src="/js/pj_channel_sdk.js"></script>
    <script src="https://rh.8688games.com/tdh5sdk.js"></script>
    <style type="text/css">
        html, body {
            width: 100%;
            height: 100%
        }

        body {
            /*
                        background: url(https://h5.infoxgame.com/images/duojiao_loading.png) no-repeat center top;
            */
            background-size: auto 100%;
        }
    </style>
    <script src="../../js/jquery/jquery.md5.js"></script>

</head>

<body>

<script type="text/javascript">

    $(function () {
        //初始化渠道sdk
        pjChannelSdk.init(10939, "smxnh5_zjyy_xh_001", "1.0.0");
        console.info("初始化sdk成功......");
        //获取游戏信息
        pjChannelSdk.getGameInfo(function (retData) {
            console.info("getGameInfo return params +++" + JSON.stringify(retData));
            if (retData.code == 1) {
                var gameName = retData.data.gameName;
                $(document).attr("title", gameName);
                var gameUrl = retData.data.gameUrl;
                var orientation = retData.data.orientation;

                //初始化渠道sdk
                TDH5SDK.init('', '', true, function () {
                    // 初始化完成逻辑
                    console.info("TDH5-初始化完成逻辑----");
                    //切换账户重新加载页面
                    TDH5SDK.switchAccount(function (data) {
                        console.info(data);
                        if (data.state =="success"){
                           pjChannelSdk["callbackState"] = data.state;
                        }
                    });
                TDH5SDK.login(function (data) {
                    console.info("TDH5-login-data----:" + JSON.stringify(data));
                    if (pjChannelSdk.callbackState =="success"){
                        location.reload();
                    }
                    if (!data.status) {
                        console.info("TDH5-ERROR-登录失败----:" + data.message);
                    }
                    //不同的渠道使用不同的拼接方式
                    var extension = JSON.stringify({
                        "userId": data.uid,
                        "status": data.status,
                        "token": data.token
                    });
                    console.info("--------request params--------:" + extension);

                    //校验渠道token
                    pjChannelSdk.getToken(extension, function (retData) {
                        if (retData.code == 1) {
                            var gameParam = {};
                            gameParam["uid"] = retData.data.userInfo.uid;
                            gameParam["sdkToken"] = retData.data.userInfo.token;

                            gameUrl = pjapi.buildURL(gameUrl, gameParam);

                            console.log("===进入游戏===>>" + gameUrl);
                            if (orientation == 0) {//横屏游戏
                                $("body").append('<div id="gameFrameDiv" style="width: 100%; height: 100%; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' + gameUrl + '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: 100%; height: 100%;"></iframe></div>');
                                window.onorientationchange = function () {
                                    if (window.orientation == 90 || window.orientation == -90) {
                                        $("#gameFrameDiv").css({"left": $(window).width() - 20, "top": "30%"});
                                    }
                                }
                            } else {//竖屏游戏
                                $("body").append('<div id="gameFrameDiv" style="width: ' + $(window).width() + 'px;  height: ' + $(window).height() + 'px; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' + gameUrl + '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: ' + $(window).width() + 'px; height: ' + $(window).height() + 'px;"></iframe></div>');
                            }

                        } else {
                            pjapi.confirmDialog(retData.msg);
                        }
                    });
                });

                });
                //开启监听事件
                pjChannelSdk.startEventListener();

            } else {
                pjapi.confirmDialog(retData.msg);
                return;
            }

        });

    });


    function receiveMessage(event) {
        console.log(event.data);
        var params = event.data.param;

        if (event.data.method == 'PJ_loadPayBox') {//拉起支付
            console.log("调用订单获取接口");
            var payParam = {};

            payParam["channelGameId"] = pjChannelSdk.initData.channelGameId;
            payParam["appVersion"] = pjChannelSdk.initData.appVersion;
            payParam["channel"] = pjChannelSdk.initData.channel;
            payParam["sdkVersion"] = pjChannelSdk.sdkVersion;


            payParam["appAccountId"] = pjChannelSdk.appAccountId;
            payParam["session"] = pjChannelSdk.session;
            payParam["sdkVersion"] = pjChannelSdk.sdkVersion;

            payParam["money"] = params["money"];
            payParam["uid"] = params["uid"];
            payParam["productName"] = params["goodsName"];
            payParam["roleId"] = params["roleId"];
            payParam["roleName"] = params["roleName"];
            payParam["serverId"] = params["serverId"];
            payParam["serverName"] = params["serverName"];
            payParam["description"] = params["description"];
            payParam["ext"] = params["ext"];
            payParam["cpOrderNo"] = params["cpOrderNo"];
            //生成融合sdk订单
            pjChannelSdk.getOrderNo(payParam, function (retData) {
                if (retData.code == 1) {
                    console.log("------获取订单成功-----:" + JSON.stringify(retData));
                    var payParams = {
                        cpOrderNo: retData.data.orderInfo.orderNumber,
                        money: retData.data.orderInfo.money,
                        productID: '1001',
                        productName: retData.data.orderInfo.goodsName,
                        roleID: retData.data.orderInfo.roleId,
                        roleName: retData.data.orderInfo.roleName,
                        roleLevel: '0',
                        serverID: retData.data.orderInfo.serverId,
                        serverName: retData.data.orderInfo.serverName,
                        productDesc: retData.data.orderInfo.goodsName,
                        roleBalance: '0',
                        roleVip: '0',
                        partyName: '',
                        notifyUrl: 'http://h5.paojiao.cn/api/payCallBack/10939',
                        extension: retData.data.orderInfo.orderNumber
                    };
                    console.info("TDH5 pay params----:" + JSON.stringify(payParams));
                    //支付完成回调（这个只是前端回调，一切以服务端的回调通知为主）
                    TDH5SDK.pay(payParams, function (data) {
                        if (data.status) {
                            console.info("TDH5 支付成功：" + JSON.stringify(data));
                        } else {
                            console.info("TDH5 支付失败：" + JSON.stringify(data));
                        }
                    })
                } else {
                    pjapi.confirmDialog(retData.msg);
                }

            });
        } else if (event.data.method == 'PJ_reportRoleInfo') {//上报角色信息
            var roleParams = {
                roleType: params["roleType"],
                roleID: params["roleid"],
                roleName: params["roleName"],
                roleLevel: params["roleLever"],
                roleCreated: params["time"],
                serverID: params["serverid"],
                serverName: params["servername"],
                roleCareer: '',
                roleBalance: params["roleMoney"],
                roleVip: params["vip"],
                partyName: '',
                baseServerId: '',
                baseServerName: '',
            }
            console.info("TDH5-Reported-params------" + JSON.stringify(roleParams));
            TDH5SDK.uploadGameRoleInfo(roleParams, function (data) {
                // 上报角色完成回调
                if (data.status) {
                    console.info("TDH5 上报成功：" + JSON.stringify(data));
                } else {
                    console.info("TDH5 上报失败：" + JSON.stringify(data));
                }
                // 回调参数说明：status：  true表示成功 false表示失败    message：回调信息
            })
        }
    }

</script>
</body>
</html>
