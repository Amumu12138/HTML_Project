package com.paojiao.sdk3.controller;

import com.alibaba.fastjson.JSONArray;
import com.alibaba.fastjson.JSONObject;
import com.alibaba.fastjson.JSONPObject;
import com.jfinal.aop.Before;
import com.jfinal.aop.Inject;
import com.jfinal.kit.JsonKit;
import com.paojiao.sdk3.common.util.SignUtil2;
import com.paojiao.sdk3.controller.thirdsdk.HttpAgent;
import com.paojiao.sdk3.controller.thirdsdk.UicodeBackslashU;
import com.paojiao.sdk3.interceptor.DomainInterceptor;
import com.paojiao.sdk3.model.PjThirdSdkChannelGame;
import com.paojiao.sdk3.service.PjThirdSdkChannelGameService;
import org.apache.commons.lang.StringUtils;

import java.net.URLDecoder;
import java.net.URLEncoder;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * 渠道角色上报接口
 */
@Before(DomainInterceptor.class)
public class RoleReportController extends BaseController {
    @Inject
    private PjThirdSdkChannelGameService channelGameService;

    private PjThirdSdkChannelGame channelGame;
    //搜狗加密key
    private static final String SOGOSECRETKEY = "{2F1AB474-4A30-409F-8AE6-49ED60A02456}";
    //英雄这边请 区服查询url
    private static final String YXZBQSERVERURL = "http://apigameh5.93jd3.com/index.php?c=game_api&a=query_server_list&appid=pjyx&game_id=52&sign=";
    //英雄这边请 登录KEY
    private static final String YXZBQKEY = "FMmd9cRFQpGMI2x4TeV9pljVVtNc33ya";

    /**
     * 厦门傲天渠道角色上报
     */
    public void xmatRoleReport() {
        log.info("---xmatRoleReport---角色上报参数：" + JsonKit.toJson(getParaMap1()));
        this.channelGame = channelGameService.findGameById(getParaToInt("channelGameId"));
        try {
            //渠道角色上报url
            String reportUrl = channelGame.getCpServerUrl();
            StringBuffer sf = new StringBuffer();
            sf.append(channelGame.getPayKey())
                    .append(getPara("server_id"))
                    .append(getPara("role_id"))
                    .append(getPara("level"))
                    .append(getPara("power"))
                    .append(getPara("revival"))
                    .append(channelGame.getCpServerId());
            log.info("---xmatRoleReport---加密参数：" + sf.toString());
            String sign = SignUtil2.md5(sf.toString());
            log.info("---xmatRoleReport---加密结果为：" + sign.toLowerCase());
            //请求渠道需要的参数
            Map<String, String> params = new HashMap<>();
            params.put("identification", channelGame.getPayKey());
            params.put("uid", getPara("uid"));
            params.put("server_id", getPara("server_id"));
            params.put("server_name", getPara("server_name"));
            params.put("role_id", getPara("role_id"));
            params.put("role_name", getPara("role_name"));
            params.put("level", getPara("level"));
            params.put("power", getPara("power"));
            params.put("revival", getPara("revival"));
            params.put("sign", sign.toLowerCase());
            log.info("---xmatRoleReport---请求参数：" + params.toString());
            String resultJson = HttpAgent.newInstance().post(reportUrl, params);
            log.info("---xmatRoleReport---返回数据：" + resultJson);
            super.renderJson(resultJson);
        } catch (Exception e) {
            log.info("---xmatRoleReport---系统错误：" + e.getMessage());
        }
    }

    /**
     * 西安游心渠道角色上报
     */
    public void xayxRoleReport() {
        log.info("---xayxRoleReport---角色上报参数：" + JsonKit.toJson(getParaMap1()));
        this.channelGame = channelGameService.findGameById(getParaToInt("channelGameId"));
        try {
            Map<String, String> roleMap = new HashMap<>();
            roleMap.put("user_id", getPara("user_id"));
            roleMap.put("game_appid", getPara("game_appid"));
            roleMap.put("server_id", getPara("server_id"));
            roleMap.put("server_name", getPara("server_name"));
            roleMap.put("role_id", getPara("role_id"));
            roleMap.put("role_name", getPara("role_name"));
            roleMap.put("level", getPara("level"));
            roleMap.put("power", getPara("power"));
            String params = SignUtil2.sortParam2(roleMap) + "&" + channelGame.getPayKey();
            log.info("---xayxRoleReport---加密参数：" + params);
            String sign = SignUtil2.md5(params);
            log.info("---xayxRoleReport---加密结果为：" + sign);
            Map<String, String> signMap = new HashMap<>();
            signMap.put("sign", sign);
            super.renderJson(JSONObject.toJSONString(signMap));
        } catch (Exception e) {
            log.info("---xayxRoleReport---系统错误：" + e.getMessage());
        }
    }


    /**
     * 搜狗 查询区服列表
     */
    public void getAreaList() {
        log.info("---getSoGoAreaClothing---区服查询参数：" + JsonKit.toJson(getParaMap1()));
        try {
            String auth = getPara("auth");
            Map<String, String> serverMap = new HashMap<>();
            serverMap.put("platform", getPara("platform"));
            serverMap.put("gid", getPara("gid"));
            serverMap.put("time", getPara("time"));
            String params = SignUtil2.sortParam2(serverMap) + "&" + SOGOSECRETKEY; //搜狗加密Key
            log.info("---getSoGoAreaClothing---加密参数：" + params);
            String sign = SignUtil2.md5(params);
            log.info("---getSoGoAreaClothing---加密结果为：" + sign);
            if (auth.equals(sign)) {
                String serverParams = "appid=pjyx&game_id=52&" + YXZBQKEY;
                String serverSign = SignUtil2.md5(serverParams);
                String result = HttpAgent.newInstance().post(YXZBQSERVERURL + serverSign, null);
                if (StringUtils.isNotEmpty(result)) {
                    JSONObject jsonObject = JSONObject.parseObject(result);
                    JSONArray jsonArray = jsonObject.getJSONArray("data");
                    Map<String, Object> serverMaps = new HashMap<>();
                    Map<String, String> serverInfoMap = new HashMap<>();
                    List<String> list = new ArrayList<>();
                    for (int i = 0; i < jsonArray.size(); i++) {
                        JSONObject jsonObject1 = jsonArray.getJSONObject(i);
                        String[] time = jsonObject1.getString("start_time").split("-");
                        if (Integer.parseInt(time[0]) >= 2020) {
                            serverInfoMap.put("sid", jsonObject1.getString("sid"));
                            serverInfoMap.put("sname", jsonObject1.getString("server_name"));
                            serverInfoMap.put("openTime", jsonObject1.getString("start_time"));
                            list.add(serverInfoMap.toString());
                        }
                    }
                    serverMaps.put("server_list", list.toString());
                    super.requestSuccess("成功", 0, serverMaps);
                    return;
                } else {
                    log.info("---getSoGoAreaClothing---返回结果为空");
                    super.requestSuccess("查询失败", 500, "");
                    return;
                }
            } else {
                log.error("---getSoGoAreaClothing---区服查询签名失败");
                super.requestSuccess("参数签名错误", 200, "");
                return;
            }
        } catch (Exception e) {
            log.info("---getSoGoAreaClothing---系统错误：" + e.getMessage());
        }
    }


    public static void main(String[] args) {
        String url = "http://apigameh5.93jd3.com/index.php?c=game_api&a=query_server_list&appid=pjyx&game_id=52&sign=";
        StringBuffer sf = new StringBuffer();
        sf.append("appid=pjyx&game_id=52&").append("FMmd9cRFQpGMI2x4TeV9pljVVtNc33ya");
        String sign = SignUtil2.md5(sf.toString());
        String result = HttpAgent.newInstance().post(url + sign, null);
        System.out.println(UicodeBackslashU.unicodeToCn(result));
        JSONObject jsonObject = JSONObject.parseObject(result);
        JSONArray jsonArray = jsonObject.getJSONArray("data");
        Map<String, Object> serverMaps = new HashMap<>();
        Map<String, String> serverInfoMap = new HashMap<>();
        List<String> list = new ArrayList<>();
        for (int i = 0; i < jsonArray.size(); i++) {
            JSONObject jsonObject1 = jsonArray.getJSONObject(i);
            String[] time = jsonObject1.getString("start_time").split("-");
            if (Integer.parseInt(time[0]) >= 2020) {
                serverInfoMap.put("sid", jsonObject1.getString("sid"));
                serverInfoMap.put("sname", jsonObject1.getString("server_name"));
                serverInfoMap.put("openTime", jsonObject1.getString("start_time"));
                list.add(serverInfoMap.toString());
            }
        }
        serverMaps.put("server_list", list.toString());
        System.out.println("-----------------" + JSONObject.toJSONString(serverMaps));
        // Map[] maps = (Map[])  JSONObject.parse(dataJson);

    }


}
