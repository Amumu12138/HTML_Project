<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-status-bar-style" content="black"/>
    <title>支付</title>
    <script>
        page = "home";
    </script>

    <link rel="stylesheet" type="text/css" href="/sdk2/css21/sdk_themes.css?v=vs">
    <link rel="stylesheet" type="text/css" href="/sdk2/css21/h5_pay_mobile.css?v=pc">
    <!--   <script type="text/javascript" src="/sdk2/js/jq4.js?v=d"></script>-->
    <script type="text/javascript" src="/sdk2/js/sdk_common.js?v=a1"></script>
    <script type="text/javascript" src="/sdk2/js/sdk2.1.js"></script>
    <script type="text/javascript" src="/sdk2/js/pj.androidutil.js"></script>
</head>
<body>
<div id="app">

    <!--支付（原价）-->
    <div class="div1">
        <div class="title_id_card">
            <div class="close"><img src="/sdk2/img/close.png"></div>
            #(gameName)
        </div>
        <div class="height40"></div>
        <div class="list_fff">
            <ul>
                <li class="left" style="white-space: nowrap;overflow: hidden;text-overflow:ellipsis;">
                    #(order.goodsName)
                </li>
                <li class="right ">
                    <span class="c000" type="number" pattern="0.00" maxFractionDigits="0">￥ #number(order.money,"#.##").00</span>
                </li>
            </ul>


            #if(cidDiscountRate > 0)
            <ul>
                <li class="left">折扣
                    <span maxFractionDigits="0">#number(cidDiscountRate * 100)折</span>
                </li>
                <li class="right">
                    ￥ -<span style="color: #fd0238" type="number" pattern="0.00" maxFractionDigits="0">#(cidDiscountMoney)</span>
                </li>
            </ul>
            #end


            <!--有代金券-->

            #if(canUseSize > 0)
            <ul>
                <li class="left">优惠券</li>
                <li class="right goto" data-canUseSize="#(canUseSize??)">
                    <strong id="deductMoney"></strong>
                    <strong id="canUseSizeSpan">#(canUseSize)张可用</strong>
                    <img src="/sdk2/img/right_ico.png">
                </li>
            </ul>
            #end


            <!--无代金券，有可领代金券 只有sdk2.1以后才能领取-->
            #if(canUseSize == 0 && canReceiveSize > 0)
            <ul>
                <li class="left">优惠券</li>

                #if(showVoucherBtn)
                <li class="right" id="receiveVoucher">领券</li>
                #end
                #if(!showVoucherBtn)
                <li class="right">暂无可用</li>
                #end
            </ul>
            #end

            <!--无代金券，无可领代金券-->
            #if(canUseSize == 0 && canReceiveSize == 0)
            <ul>
                <li class="left">优惠券</li>
                <li class="right">暂无可用</li>
            </ul>
            #end
        </div>

        <div class="list_fff pay_li">

            #for(config : payConfigList)

            <ul data-payConfigId="#(config.id??)" data-payType="#(config.payType??)"
                class="#(for.index?? == 0?'active':'')">
                <li class="left">
                    #if(config.payType ==1)
                    <img src="/sdk2/img/pay.png">支付宝
                    #end
                    #if(config.payType ==2)
                    <img src="/sdk2/img/wx.png">微信
                    #end

                    #if(config.payType == 3)
                    <div>
                        <img src="/sdk2/img/ico2.png">游币
                        #if(goldDiscount != null)
                        <strong>推荐</strong>
                        #end
                    </div>
                    #if(goldDiscount != null)
                    <div>
                        <span>充值#number(goldDiscount.lowDiscount * 100)折起</span>
                        <span>最高省#number(goldDiscount.maxDiscountMoney,"##")元</span>

                    </div>
                    #end

                    #end

                </li>
                <li class="right">
                    #switch(config.payType)
                    #case (3)
                    <span>#(userGold)游币</span>

                    #if(showRechargeBtn)
                    <strong id="goldRecharge"
                            class="#((userGold/10) < (order.money - cidDiscountMoney) ? 'currencyBlock' : 'currencyNone')">充值</strong>
                    #end
                    <div class="#((userGold/10) >= (order.money - cidDiscountMoney) ? 'currencyBlock' : 'currencyNone') payType"
                         data-payConfigId="#(config.id??)" data-payType="#(config.payType??)"></div>

                    #default
                    <div class="payType" data-payConfigId="#(config.id??)" data-payType="#(config.payType??)"></div>
                    #end
                </li>
            </ul>
            #end

        </div>

        <div class="height100"></div>
        <div class="bottom_button">


            <div class="height100"></div>
            <div class="bottom_button">
                <div class="left">
                    ￥<span id="leftTopTxt">#(order.money - cidDiscountMoney)</span>
                    <strong id="leftBotTxt">已节省#number(cidDiscountMoney,"#.##")元</strong>
                </div>
                <div class="right">
                    <div>
                        <button id="payBtn">立即付款</button>
                        <span id="rightTxt">支付后可得#(credits)积分</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end 支付（原价）-->

    <!--代金券-->
    <div class="div2">
        <div class="title_id_card">
            <div class="back1"><img src="/sdk2/img/back1.png"></div>
            代金券
        </div>
        <div class="height40"></div>
        <div class="coupon_div">
            #for(voucherItem : userVoucherList)
            #if(voucherItem.canUse)
            <div class="coupon_li" data-canUse="#(voucherItem.canUse??)" data-deductMoney="#(voucherItem.deduct??)"
                 data-voucherId="#(voucherItem.id??)">
                <div class="moeny">
                    <div>￥<span>#(voucherItem.deduct)</span></div>
                    #if(voucherItem.rule == 1)
                    满#(voucherItem.achieveMoney)可用
                    #else
                    无门槛
                    #end
                </div>
                <div class="img_line"></div>
                <div class="moeny_body">
                    <div>
                        #if(voucherItem.rule == 1)
                        满#(voucherItem.achieveMoney)减#(voucherItem.deduct)
                        #else
                        #(voucherItem.deduct)元无门槛代金券
                        #end
                    </div>
                    #if(voucherItem.expiredDays > 5)
                    <span>#date(voucherItem.expiredEnd, "yyyy-MM-dd")前有效</span>
                    #end

                    #if(voucherItem.expiredDays <= 5)
                    <span class="red">还有#(voucherItem.expiredDays)天过期</span>
                    #end
                    <span>适用范围:#if(voucherItem.applicableRange == 1)#(voucherItem.gameNames)
                            #else
                            全平台
                            #end
                        </span></div>
                <div class="button">
                    <div></div>
                </div>
            </div>
            #end
            #end
            <div class="height100"></div>
        </div>
        <div class="bottom_button red_button">完成</div>

    </div>
    <!--end 代金券-->

    #if(canUseSize > 0)
    <!--退出有优惠券提示-->
    <div class="div3">
        <div class="title_id_card">
            本单可使用代金券立省 <strong>#(maxDeductVoucher.deduct)</strong> 元
        </div>
        <div class="height40"></div>
        <div class="coupon_div">
            <!---->
            <div class="coupon_li top30 active notSelect" data-isMaxDeductVoucher="1" data-isMaxDeductVoucher="1"
                 data-canUse="#(maxDeductVoucher.canUse??)" data-deductMoney="#(maxDeductVoucher.deduct??)"
                 data-voucherId="#(maxDeductVoucher.id??)">
                <div class="moeny">
                    <div>￥<span>#(maxDeductVoucher.deduct)</span></div>
                    #(maxDeductVoucher.rule?? == 1? "满"+maxDeductVoucher.achieveMoney +"可用":"无门槛")
                </div>
                <div class="img_line"></div>
                <div class="moeny_body">
                    <div>#(maxDeductVoucher.rule?? == 1? "满"+ maxDeductVoucher.achieveMoney +"减"+
                        maxDeductVoucher.deduct : maxDeductVoucher.deduct + "元无门槛代金券")
                    </div>
                    #if(maxDeductVoucher.expiredDays > 5)
                    <span>#date(maxDeductVoucher.expiredEnd,'yyyy-MM-dd')前有效</span>
                    #end
                    #if(maxDeductVoucher.expiredDays <= 5)
                    <span class="red">还有#(maxDeductVoucher.expiredDays)天过期</span>
                    #end
                    <span>适用范围:#(maxDeductVoucher.applicableRange?? == 1?maxDeductVoucher.gameNames??:'全平台')</span>
                </div>
                <div class="button">
                    <div></div>
                </div>
            </div>
            <!---->
            <div class="height100"></div>
        </div>
        <div class="bottom_button2">
            <div class="left out">放弃支付</div>
            <div class="right goto_pay">继续支付</div>
        </div>
    </div>
    <!--end 退出有优惠券提示-->

    #end

    #if(canUseSize == 0)
    <!--无券时，退出提示-->
    <div class="div3">
        <div class="height40"></div>
        <div class="zf_font">确定要退出支付吗？</div>
        <div class="height100"></div>
        <div class="bottom_button2">
            <div class="left out">放弃支付</div>
            <div class="right goto_pay">继续支付</div>
        </div>
    </div>
    <!--end 无券时，退出提示-->
    #end

    <input id="orderPirce" name="orderPirce" type="hidden" value="#number(order.money,'##')"/>
    <input id="voucherPrice" name="voucherPrice" type="hidden" value="0"/>
    <input id="voucherId" name="voucherId" type="hidden"/>
    <input id="discountPrice" name="discountPrice" type="hidden" value="#(cidDiscountMoney??)"/>

    #for(config : payConfigList)
    #if(for.index == 0)
    <input id="payType" name="payType" type="hidden" value="#(config.payType??)"/>
    <input id="payConfigId" name="payConfigId" type="hidden" value="#(config.id??)"/>
    #end
    #end
    <input id="puid" name="puid" type="hidden" value="#(ppUser.id??)"/>
    <input id="uid" name="uid" type="hidden" value="#(ppUser.uid1??)"/>
    <input id="orderNumber" name="orderNumber" type="hidden" value="#(order.orderNumber??)"/>
    <input id="userGold" name="userGold" type="hidden" value="#(userGold??)"/>
    <input id="returnUrl" name="returnUrl" type="hidden" value="#(order.returnUrl??)"/>
    <input id="wxOpenId" name="wxOpenId" type="hidden" value="#(wxOpenId??)"/>
    <input id="gameId" name="gameId" type="hidden" value="#(order.gameId??)"/>
    <input id="channel" name="channel" type="hidden" value="#(order.cid??)"/>

    <input id="goldRechargeUrl" name="goldRechargeUrl" type="hidden" value="#(goldRechargeUrl??)"/>
    <input id="voucherUrl" name="voucherUrl" type="hidden" value="#(voucherUrl??)"/>


    <!--提示框-->
    <div class="open_box">
        <div class="box_font" id="box_font"></div>
    </div>
    <!--end 提示框-->
</div>

</body>

</html>
