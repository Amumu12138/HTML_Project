package com.paojiao.sdk3.controller.thirdsdk.yunyou;

import com.alibaba.fastjson.JSON;
import com.alibaba.fastjson.JSONObject;
import com.jfinal.aop.Aop;
import com.jfinal.kit.JsonKit;
import com.paojiao.sdk3.common.util.DateUtil;
import com.paojiao.sdk3.common.util.PjMap;
import com.paojiao.sdk3.common.util.SignUtil;
import com.paojiao.sdk3.controller.pay.PayStatus;
import com.paojiao.sdk3.controller.thirdsdk.*;
import com.paojiao.sdk3.model.PjCpGame;
import com.paojiao.sdk3.model.PjThirdSdkChannel;
import com.paojiao.sdk3.model.PjThirdSdkChannelGame;
import com.paojiao.sdk3.model.PjThirdSdkOrder;
import com.paojiao.sdk3.service.PjThirdSdkChannelGameService;
import com.paojiao.sdk3.service.PjThirdSdkChannelService;
import com.paojiao.sdk3.service.PjThirdSdkOrderService;
import org.apache.commons.lang.StringUtils;
import org.apache.log4j.Logger;

import javax.servlet.http.HttpServletRequest;
import java.net.URLEncoder;
import java.util.HashMap;
import java.util.Map;

/**
 * 类描述：云游 SDK
 *
 * @Author: jiangkun
 * @Date: 2020/07/01 15:57
 */
public class YunYouSDK implements ItfSdk {
    private static final Logger log = Logger.getLogger(YunYouSDK.class);
    private PjThirdSdkOrderService orderService = Aop.get(PjThirdSdkOrderService.class);
    private PjThirdSdkChannelGameService channelGameService = Aop.get(PjThirdSdkChannelGameService.class);
    private PjThirdSdkChannelService channelService = Aop.get(PjThirdSdkChannelService.class);

    @Override
    public void verify(PjThirdSdkChannel sdkChannel, PjThirdSdkChannelGame channelGame, PjCpGame game, String sdkToken, ISDKVerifyListener callback) {
        try {
            log.info("YunYouSDK-verify  客户端登录返回:" + sdkToken);
            if (StringUtils.isEmpty(sdkToken)) {
                log.info("YunYouSDK-verify 客户端登录返回为空");
                callback.onFailed("YunYouSDK-verify failed: " + " 客户端登录返回为空");
                return;
            }
            JSONObject json = JSONObject.parseObject(sdkToken);
            final String appId = json.getString("app_id");
            final String memId = json.getString("mem_id");
            final String userToken = json.getString("user_token");
            if (StringUtils.isEmpty(appId)) {
                log.info("YunYouSDK-verify: appId为空");
                callback.onFailed("YunYouSDK-verify failed: appId为空");
                return;
            }
            if (StringUtils.isEmpty(memId)) {
                log.info("YunYouSDK-verify: memId为空");
                callback.onFailed("YunYouSDK-verify failed: memId为空");
                return;
            }
            if (StringUtils.isEmpty(userToken)) {
                log.info("YunYouSDK-verify: userToken为空");
                callback.onFailed("YunYouSDK-verify failed: userToken为空");
                return;
            }
            //将参数加密,并将加密后的结果请求到渠道
            StringBuffer sf = new StringBuffer();
            sf.append("app_id=").append(appId)
                    .append("&mem_id=").append(memId)
                    .append("&user_token=").append(userToken)
                    .append("&app_key=").append(channelGame.getPayKey());
            log.info("YunYouSDK-verify  参数加密前: " + sf.toString());
            String newSign = SignUtil.md5(sf.toString());
            log.info("YunYouSDK-verify  参数加密后: " + newSign);
            //请求渠道需要的参数
            Map<String,String> mapParams = new HashMap<>();
            mapParams.put("app_id",appId);
            mapParams.put("mem_id",memId);
            mapParams.put("user_token",userToken);
            mapParams.put("sign",newSign);
            String url = sdkChannel.getAuthUrl();
            HttpAgent.newInstance().post(url, mapParams, new HttpFutureCallback() {
                @Override
                public void completed(String content) {
                    log.info("YunYouSDK-verify:验证登录返回参数："+content);
                    JSONObject json = JSONObject.parseObject(content);
                    if (json.get("status").toString().equals("1")){
                        callback.onSuccess(new SDKVerifyResult(true, memId, "", null, ""));
                        return;
                    }else {
                        callback.onFailed(sdkChannel.getSdkCode() + " YunYouSDK-verify failed："+json.get("msg").toString());
                        return;
                    }

                }
                @Override
                public void failed(String err) {
                    callback.onFailed(sdkChannel.getSdkCode() + " YunYouSDK-verify failed：验证签名错误");
                    return;
                }
            });
        } catch (Exception e) {
            e.printStackTrace();
            callback.onFailed(sdkChannel.getSdkCode()
                    + " verify execute failed. the exception is "
                    + e.getMessage());
        }
    }

    @Override
    public void orderCallBack(PjMap<String, String> params, HttpServletRequest request, ISDKVerifyListener callback) {
        log.info("YunYouSDK.orderCallBack:" + JsonKit.toJson(params));
        SDKVerifyResult vs = new SDKVerifyResult();
        try {
            PjThirdSdkChannelGame channelGame = channelGameService.findGameById(params.getToInt("channelGameId"));
            String sign = params.get("sign");
            try {
                StringBuffer sf = new StringBuffer();
                sf.append("app_id=").append(params.get("app_id"))
                    .append("&cp_order_id=").append(params.get("cp_order_id"))
                        .append("&ext=").append(params.get("ext"))
                        .append("&mem_id=").append(params.get("mem_id"))
                        .append("&order_id=").append(params.get("order_id"))
                        .append("&order_status=").append(params.get("order_status"))
                        .append("&pay_time=").append(params.get("pay_time"))
                        .append("&product_id=").append(params.get("product_id"))
                        .append("&product_name=").append(params.get("product_name"))
                        .append("&product_price=").append(params.get("product_price"))
                        .append("&app_key=").append(channelGame.getPayKey());
                log.info("YunYouSDK.orderCallBack 加密前参数：" + sf.toString());
                String newSign = SignUtil.md5(sf.toString());
                log.info("YunYouSDK.orderCallBack 加密结果为：" + newSign);
                if (!sign.equals(newSign)) {
                    log.error("YunYouSDK ERROR Invalid sign original string:" + newSign + " your sign:" + sign);
                    vs.setReturnMsg("FAILURE");
                    callback.onSuccess(vs);
                    return;
                }
                String cporder = params.get("cp_order_id");
                PjThirdSdkOrder iod = orderService.findOrderByOrderNo(cporder);
                if (iod == null) {
                    log.error("YunYouSDK.orderCallBack ERROR:orer not found,orderNo:[" + cporder + "]");
                } else if (iod.getStatus() == PayStatus.PAY_SUCCESS.id) {// 已完成支付
                    log.error("YunYouSDK.orderCallBack 重复回调,orderNo:[" + cporder + "]");
                    vs.setReturnMsg("SUCCESS");
                    callback.onSuccess(vs);
                    return;
                }
                // 真实收款
                Double amount = Double.valueOf(params.get("product_price"));
                // 实际收款金额不一致
                if (iod.getMoney() != amount.floatValue()) {
                    log.error("YunYouSDK.orderCallBack 收款金额与订单金额不符,orderNo:[" + cporder + "],订单金额："
                            + iod.getMoney() + ",实际收款金额：" + amount);
                    vs.setReturnMsg("FAILURE");
                    callback.onSuccess(vs);
                    return;
                }
                log.info("+++++++++YunYouSDK，完成支付....");
                orderService.finishOrderAndCallbackCp(cporder,
                        params.get("order_id"));
            } catch (Exception e) {
                log.error("YunYouSDK.orderCallBack error:" + e.getMessage());
                vs.setReturnMsg("FAILURE");
                callback.onSuccess(vs);
                return;
            }
            vs.setReturnMsg("SUCCESS");
            callback.onSuccess(vs);
        } catch (Exception e) {
            vs.setReturnMsg("FAILURE");
            callback.onSuccess(vs);
            log.error("YunYouSDK.orderCallBack 充值回调请求异常！params:[" + JsonKit.toJson(params) + "]");
            e.printStackTrace();
        }
    }

    @Override
    public void getOrderNo(PjThirdSdkChannel sdkChannel, PjThirdSdkChannelGame channelGame, PjThirdSdkOrder order, PjMap<String, String> params, ISDKVerifyListener callback) {
    }
}
