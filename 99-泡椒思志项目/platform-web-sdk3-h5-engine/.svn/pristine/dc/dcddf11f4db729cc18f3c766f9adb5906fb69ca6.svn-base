<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="full-screen" content="true" />
    <meta name="screen-orientation" content="portrait" />

    <title>斗剑仙</title>

    <link href="/css/common.css" rel="stylesheet">
    <link href="/css//layout.css" rel="stylesheet">

    <script type="text/javascript" src="/js/jquery/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="/js/jquery/jquery.md5.js"></script>
    <script type="text/javascript" src="/js/pj_api.js"></script>
    <script type="text/javascript" src="/js/pj_channel_sdk.js"></script>
    <!-- 引入sdk -->
    <script type="text/javascript" src="https://staticjs.quickapi.net/static/lib/libQuickSDK_v2.js"></script>
    <style type="text/css">
        html,
        body {
            width: 100%;
            height: 100%
        }

        body {
            background: url(https://h5.paojiao.cn/images/qutoutiao/qtt_login_page.png) no-repeat center top;
            background-size: auto 100%;
        }

        #qtt_loading_img {
            position: fixed;
            z-index: 9999;
            width: 100%;
            height: 100%;
            left: 0;
            top: 0;
            /* background: rgba(0, 0, 0, .8); */
            /*background: url(https://h5.paojiao.cn/images/qutoutiao/qtt_loading_flash_xdhmy.png) 0 0/100% 100% no-repeat;*/
        }
    </style>
    <script src="../../js/jquery/jquery.md5.js"></script>

</head>

<body>
    <!--<img id="qtt_loading_img">-->

    <script type="text/javascript">
        $(function () {
            //初始化渠道sdk
            pjChannelSdk.init(10999, "smxnh5_xjhy_xh_002", "1.0.0");
            console.info("初始化sdk成功......");

            var productCode = '74480936142641506412435545381528'; //QuickSDK后台自动分配 
            var productKey = '97707069595000074209554007823102'; //QuickSDK后台自动分配 
            //初始化
            QuickSDK.init(productCode, productKey, true, function () {
                console.log("init success");
            });

            //获取游戏信息
            pjChannelSdk.getGameInfo(function (retData) {
                console.info("getGameInfo return params +++" + JSON.stringify(retData));
                if (retData.code == 1) {
                    var gameName = retData.data.gameName;
                    $(document).attr("title", gameName);
                    var gameUrl = retData.data.gameUrl;
                    var orientation = retData.data.orientation;

                    var _params = pjapi.getURLParams();
                    console.info("--------_params--------:" + JSON.stringify(_params));
                    QuickSDK.login(function (callbackData) {
                        var message;
                        if (callbackData.status) {
                            console.log('GameDemo:QuickSDK登录成功: data=>' + callbackData.data);
                            //不同的渠道使用不同的拼接方式
                            var extension = JSON.stringify({
                                "uid": callbackData.data.uid, //渠道uid
                                "username": callbackData.data.username, //渠道username
                                "token": callbackData.data.token, //token
                                "isLogin": callbackData.data.isLogin, //是否游客,登陆后此值为true
                                "channelId": callbackData.data.channelId //渠道ID
                            });
                            //保存渠道用户信息
                            pjChannelSdk["sdkUserId"] = callbackData.data.uid;
                            pjChannelSdk["username"] = callbackData.data.username;
                            // pjChannelSdk["game_appid"] = _params.game_appid;

                            console.info("--------reuqest params--------:" + extension);

                            //校验渠道token
                            pjChannelSdk.getToken(extension, function (retData) {
                                console.info("getToken return params-------：" + JSON
                                    .stringify(
                                        retData));
                                if (retData.code == 1) {
                                    var gameParam = {};
                                    gameParam["uid"] = retData.data.userInfo.uid;
                                    gameParam["sdkToken"] = retData.data.userInfo.token;
                                    gameUrl = pjapi.buildURL(gameUrl, gameParam);

                                    console.log("===进入游戏===>>" + gameUrl);
                                    if (orientation == 0) { //横屏游戏
                                        $("body").append(
                                            '<div id="gameFrameDiv" style="width: 100%; height: 100%; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' +
                                            gameUrl +
                                            '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: 100%; height: 100%;"></iframe></div>'
                                        );
                                        window.onorientationchange = function () {
                                            if (window.orientation == 90 || window
                                                .orientation == -
                                                90) {
                                                $("#gameFrameDiv").css({
                                                    "left": $(window)
                                                        .width() - 20,
                                                    "top": "30%"
                                                });
                                            }
                                        }
                                    } else { //竖屏游戏
                                        $("body").append(
                                            '<div id="gameFrameDiv" style="width: ' +
                                            $(
                                                window).width() + 'px;  height: ' +
                                            $(window)
                                            .height() +
                                            'px; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' +
                                            gameUrl +
                                            '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: ' +
                                            $(window).width() + 'px; height: ' + $(
                                                window)
                                            .height() + 'px;"></iframe></div>');
                                    }
                                } else {
                                    pjapi.confirmDialog(retData.msg);
                                }
                            });
                            //开启监听事件
                            pjChannelSdk.startEventListener();
                        } else {
                            console.log('GameDemo:QuickSDK登录失败:' + callbackData.message);
                        }
                    });
                } else {
                    pjapi.confirmDialog(retData.msg);
                    return;
                }
            });
        });

        function receiveMessage(event) {
            console.log(event.data);
            var params = event.data.param;

            if (event.data.method == 'PJ_loadPayBox') { //拉起支付
                console.log("调用订单获取接口");
                var payParam = {};

                payParam["channelGameId"] = pjChannelSdk.initData.channelGameId;
                payParam["appVersion"] = pjChannelSdk.initData.appVersion;
                payParam["channel"] = pjChannelSdk.initData.channel;
                payParam["sdkVersion"] = pjChannelSdk.sdkVersion;
                //渠道需要签名时的参数
                payParam["sdkUserId"] = pjChannelSdk.sdkUserId;
                payParam["sdkUserName"] = pjChannelSdk.username;

                payParam["money"] = params["money"];
                payParam["uid"] = params["uid"];
                payParam["productName"] = params["goodsName"];
                payParam["roleId"] = params["roleId"];
                payParam["roleName"] = params["roleName"];
                payParam["serverId"] = params["serverId"];
                payParam["serverName"] = params["serverName"];
                payParam["description"] = params["description"];
                payParam["ext"] = params["ext"];
                payParam["cpOrderNo"] = params["cpOrderNo"];

                console.log("------------payParam--------------" + JSON.stringify(payParam));
                //生成融合sdk订单
                pjChannelSdk.getOrderNo(payParam, function (retData) {
                    console.log("Amumu xjhy getOrderNo retData = ", retData);
                    if (retData.code == 1) {
                        console.log("获取订单成功：" + JSON.stringify(retData));
                        orderInfo = new Object();
                        orderInfo.productCode = "74480936142641506412435545381528"; //QuickSDK后台自动分配的参数
                        orderInfo.uid = pjChannelSdk.sdkUserId; //渠道UID
                        orderInfo.username = pjChannelSdk.username; //渠道username
                        orderInfo.userRoleId = retData.data.roleInfo.roleId; //游戏内角色ID
                        orderInfo.userRoleName = retData.data.roleInfo.roleName; //游戏角色
                        orderInfo.serverId = retData.data.roleInfo.serverId; //角色所在区服ID
                        orderInfo.userServer = retData.data.roleInfo.serverName; //角色所在区服
                        orderInfo.userLevel = params.roleLever; //角色等级
                        orderInfo.cpOrderNo = retData.data.roleInfo.orderNumber; //游戏内的订单,服务器通知中会回传
                        orderInfo.amount = retData.data.roleInfo.money; //购买金额(元)
                        orderInfo.subject = retData.data.roleInfo.goodsName; //道具名称
                        orderInfo.desc = params.description; //道具描述
                        orderInfo.callbackUrl = ''; //服务器通知地址
                        orderInfo.extrasParams = retData.data.roleInfo.orderNumber; //游戏内的订单,服务器通知中会回传
                        orderInfo.goodsId = 'goods'; //商品ID
                        orderInfo.count = retData.data.roleInfo.money; //购买商品个数
                        orderInfo.quantifier = '个'; //购买商品单位
                        var orderInfoJson = JSON.stringify(orderInfo);
                        console.log("Amumu xjhy getOrderNo orderInfoJson = ", orderInfoJson);
                        QuickSDK.pay(orderInfoJson, function (payStatusObject) {
                            console.log('GameDemo:下单通知' + JSON.stringify(payStatusObject));
                        });
                    } else {
                        pjapi.confirmDialog(retData.msg);
                    }
                });
            } else if (event.data.method == 'PJ_reportRoleInfo') { //上报角色信息
                console.log("调用上报角色信息接口");
                var roleType = params["roleType"];
                var role_id = params["roleid"];
                var role_name = params["roleName"];
                var role_level = params["roleLever"];
                var server_id = params["serverid"];
                var server_name = params["servername"];
                var fightvalue = params["fightvalue"];
                var vip = params["vip"];
                var time = params["time"];
                var extar = params["extar"];
                var isCreateRole = false;

                console.log("------------上报角色信息--------------" + JSON.stringify(params));
                //判断是否为创建角色
                if (roleType == 2) {
                    isCreateRole = true;
                    window.localStorage.setItem("createRoleTime", time);
                    console.log("Amumu create roleCreateTime = ", time);
                }
                console.log("Amumu roleCreateTime = ", window.localStorage.getItem("createRoleTime"));
                var roleInfo = new Object();
                roleInfo.isCreateRole = isCreateRole; //仅创建角色时传true,更新信息时传false
                roleInfo.roleCreateTime = window.localStorage.getItem("createRoleTime") || time;; //角色创建时间
                roleInfo.uid = pjChannelSdk.sdkUserId; //UID
                roleInfo.username = pjChannelSdk.username; //username
                roleInfo.serverId = server_id; //区服ID
                roleInfo.serverName = server_name; //区服名称
                roleInfo.userRoleName = role_name; //游戏角色名称
                roleInfo.userRoleId = role_id; //游戏角色ID
                roleInfo.userRoleBalance = ''; //角色游戏内货币余额
                roleInfo.vipLevel = vip; //角色VIP等级
                roleInfo.userRoleLevel = role_level; //角色等级
                roleInfo.partyId = 1; //工会社团ID
                roleInfo.partyName = ''; //工会社团名称
                roleInfo.gameRoleGender = ''; //角色性别
                roleInfo.gameRolePower = fightvalue; //角色战力
                roleInfo.partyRoleId = 1; //角色在帮派ID
                roleInfo.partyRoleName = ''; //角色在帮派中的名称
                roleInfo.professionId = ''; //角色职业ID
                roleInfo.profession = ''; //角色职业名称
                roleInfo.friendlist = ''; //角色好友列表
                var roleInfoJson = JSON.stringify(roleInfo);
                console.log("Amumu xjhy reportRoleInfo roleInfoJson", roleInfoJson);
                QuickSDK.uploadGameRoleInfo(roleInfoJson, function (response) {
                    console.log("Amumu xjhy QuickSDK uploadGameRoleInfo success response = ", response);
                });
            }
        }
    </script>
</body>

</html>