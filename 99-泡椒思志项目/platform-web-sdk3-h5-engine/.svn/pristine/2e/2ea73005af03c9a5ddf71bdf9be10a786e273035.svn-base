<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-status-bar-style" content="black"/>
    <title>支付</title>
    <script>
        page = "home";
    </script>

    <link rel="stylesheet" type="text/css" href="/sdk2/css/sdk_themes.css?v=vs">
    <link rel="stylesheet" type="text/css" href="/sdk2/css/h5_pay_mobile.css?v=pc">
    <!--   <script type="text/javascript" src="/sdk2/js/jq4.js?v=d"></script>-->
    <script type="text/javascript" src="/sdk2/js/sdk_common.js?v=a1"></script>
    <script type="text/javascript" src="/sdk2/js/home_js.js"></script>
    <script type="text/javascript" src="/sdk2/js/pj.androidutil.js"></script>
</head>

<body>
<!--安卓低版本适配-->
<!--<div id="az_js"></div>
<script type="text/javascript" src="/sdk2/js/az_js.js?v=a1"></script>-->
<!--end-->


<!--支付（原价）-->

<div class="div1">

    <div class="title_id_card">
        <div class="close"><img src="/sdk2/img/close.png"></div>
        支付
    </div>
    <div class="height40"></div>
    <div class="list_fff">
        <ul>
            <li class="left" type="number">充值#number(order.money,"##")元</li>
            <li class="right">
                ￥<span type="number" pattern="0.00" maxFractionDigits="0">#number(order.money,"##")</span>
            </li>
        </ul>
        <ul>
            <li class="left">优惠券</li>
            <li class="right goto" id="selectVoucher" data-canUseSize="#(canUseSize??)">
                <span id="deductMoney"></span>
                <strong>#(canUseSize)张可用</strong>
                <img src="/sdk2/img/right_ico.png">
            </li>
        </ul>
    </div>

    <div class="list_fff pay_li">
        #for(config : payConfigList)
        <ul data-payConfigId="#(config.id??)" data-payType="#(config.payType??)" class="#(for.index?? == 0?'active':'')">
            <li class="left" >
                #if(config.payType ==1)
                <img src="/sdk2/img/pay.png">支付宝
                #end
                #if(config.payType ==2)
                <img src="/sdk2/img/wx.png">微信
                #end
                #if(config.payType ==3)
                <img src="/sdk2/img/ico2.png">游币
                #end
            </li>
            <li class="right">
                #if(config.payType == 3)
                <span>#(userGold)游币</span> <span style="display: none" id="goldTxt">（不足支付）</span>
                #end
                <div></div>
            </li>
        </ul>
        #end
    </div>

    <div class="height100"></div>
    <div class="bottom_button">


        <div class="left" id="otherPay">
            ￥<span id="actualPrice1">#number(order.money,"##")</span>
            <span class="money" id="originalPrice1" style="display: none;">
                ￥#number(order.money,"##")</span>
        </div>

        <div class="left" id="goldPay" style="display: none">
            ￥<span id="actualPrice2">
            #number(order.money,"##")
        </span>
            <strong id="walletCost">将消耗<strong id="walletCostGold"></strong>游币</strong>
        </div>


        <div class="right">
            <button id="payBtn">立即付款</button>
        </div>
    </div>
</div>
<!--end 支付（原价）-->

<!--代金券-->
<div class="div2">
    <div class="title_id_card">
        <div class="back1"><img src="/sdk2/img/back1.png"></div>
        代金券
    </div>
    <div class="height40"></div>
    <div class="coupon_div">
        #for(voucherItem : userVoucherList)
        #if(voucherItem.canUse)
        <div class="coupon_li" data-canUse="#(voucherItem.canUse??)" data-deductMoney="#(voucherItem.deduct??)"
             data-voucherId="#(voucherItem.id??)">
            <div class="moeny">
                <div>￥<span>#(voucherItem.deduct)</span></div>
                #if(voucherItem.rule == 1)
                满#(voucherItem.achieveMoney)可用
                #else
                无门槛
                #end
            </div>
            <div class="img_line"></div>
            <div class="moeny_body">
                <div>
                    #if(voucherItem.rule == 1)
                    满#(voucherItem.achieveMoney)减#(voucherItem.deduct)
                    #else
                    #(voucherItem.deduct)元无门槛代金券
                    #end
                </div>
                #if(voucherItem.expiredDays > 5)
                <span>#date(voucherItem.expiredEnd, "yyyy-MM-dd")前有效</span>
                #end

                #if(voucherItem.expiredDays <= 5)
                <span class="red">还有#date(voucherItem.expiredDays, "yyyy-MM-dd")天过期</span>
                #end
                <span>适用范围:#if(voucherItem.applicableRange == 1)#(voucherItem.gameNames)
                            #else
                            全平台
                            #end
                        </span></div>
            <div class="button">
                <div></div>
            </div>
        </div>
        #end
        #end
        #if(canNotUseSize > 0)
        <div class="more2">不可用代金券</div>
        #for(voucherItem : userVoucherList)
        #if(!voucherItem.canUse)
        <div class="coupon_li opacity6" data-canUse="#(voucherItem.canUse??)"
             data-deductMoney="#(voucherItem.deduct??)" data-voucherId="#(voucherItem.id??)">
            <div class="moeny">
                <div>￥<span>#(voucherItem.deduct)</span></div>
                #if(voucherItem.rule == 1)
                满#(voucherItem.achieveMoney)可用
                #else
                无门槛
                #end
            </div>
            <div class="img_line"></div>
            <div class="moeny_body">
                <div>
                    #if(voucherItem.rule ==1)
                    满#(voucherItem.achieveMoney)减#(voucherItem.deduct)
                    #else
                    #(voucherItem.deduct)元无门槛代金券
                    #end
                </div>
                #if(voucherItem.expiredDays > 5)
                <span>#date(voucherItem.expiredEnd,'yyyy-MM-dd')前有效</span>
                #end

                #if(voucherItem.expiredDays <= 5)
                <span class="red">还有#date(voucherItem.expiredDays,'yyyy-MM-dd')天过期</span>
                #end
                <span>适用范围:#if(voucherItem.applicableRange == 1)
                                       #(voucherItem.gameNames)
                                       #else
                                      全平台
                   #end
                          </span></div>
        </div>
        #end
        #end
        #end
        <div class="height100"></div>
    </div>
    <div class="bottom_button red_button">完成</div>

</div>
<!--end 代金券-->

#if(canUseSize > 0)
<!--退出有优惠券提示-->
<div class="div3">
    <div class="title_id_card">
        本单可使用代金券立省 <strong>#(maxDeductVoucher.deduct)</strong> 元
    </div>
    <div class="height40"></div>
    <div class="coupon_div">
        <!---->
        <div class="coupon_li top30 active notSelect" data-isMaxDeductVoucher="1" data-isMaxDeductVoucher="1" data-canUse="#(maxDeductVoucher.canUse??)" data-deductMoney="#(maxDeductVoucher.deduct??)"  data-voucherId="#(maxDeductVoucher.id??)">
            <div class="moeny">
                <div>￥<span>#(maxDeductVoucher.deduct)</span></div>
                #(maxDeductVoucher.rule?? == 1? "满"+maxDeductVoucher.achieveMoney +"可用":"无门槛")
            </div>
            <div class="img_line"></div>
            <div class="moeny_body">
                <div>#(maxDeductVoucher.rule?? == 1? "满"+ maxDeductVoucher.achieveMoney +"减"+ maxDeductVoucher.deduct : maxDeductVoucher.deduct + "元无门槛代金券")
                </div>
                #if(maxDeductVoucher.expiredDays > 5)
                <span>#date(maxDeductVoucher.expiredEnd,'yyyy-MM-dd')前有效</span>
                #end
                #if(maxDeductVoucher.expiredDays <= 5)
                    <span class="red">还有#date(maxDeductVoucher.expiredDays,'yyyy-MM-dd')天过期</span>
                #end
                <span>适用范围:#(maxDeductVoucher.applicableRange?? == 1?maxDeductVoucher.gameNames??:'全平台')</span></div>
            <div class="button">
                <div></div>
            </div>
        </div>
        <!---->
        <div class="height100"></div>
    </div>
    <div class="bottom_button2">
        <div class="left out">放弃支付</div>
        <div class="right goto_pay">继续支付</div>
    </div>
</div>
<!--end 退出有优惠券提示-->

#end

    #if(canUseSize == 0)
    <!--无券时，退出提示-->
    <div class="div3">
        <div class="height40"></div>
        <div class="zf_font">确定要退出支付吗？</div>
        <div class="height100"></div>
        <div class="bottom_button2">
            <div class="left out">放弃支付</div>
            <div class="right goto_pay">继续支付</div>
        </div>
    </div>
    <!--end 无券时，退出提示-->
#end

<form id="payGameForm" accept-charset="UTF-8" action="/pay/payTest" method="post">
    <input id="orderPirce" name="orderPirce" type="hidden" value="#number(order.money,'##')"/>
    <input id="voucherPrice" name="voucherPrice" type="hidden" value="0"/>
    <input id="voucherId" name="voucherId" type="hidden"/>

    #for(config : payConfigList)
    #if(for.index == 0)
            <input id="payType" name="payType" type="hidden" value="#(config.payType??)"/>
            <input id="payConfigId" name="payConfigId" type="hidden" value="#(config.id??)"/>
    #end
    #end
    <input id="puid" name="puid" type="hidden" value="#(ppUser.id??)"/>
    <input id="uid" name="uid" type="hidden" value="#(ppUser.uid1??)"/>
    <input id="orderNumber" name="orderNumber" type="hidden" value="#(order.orderNumber??)"/>
    <input id="userGold" name="userGold" type="hidden" value="#(userGold??)"/>
    <input id="returnUrl" name="returnUrl" type="hidden" value="#(order.returnUrl??)"/>

</form>


<!--提示框-->
<div class="open_box">
    <div class="box_font" id="box_font"></div>
</div>
<!--end 提示框-->

<a id="goToUrl"  target="_blank" style="display:none"></a>
</body>


</html>
