	params["channel"] = sdk.getItem("channel"); //渠道号
	params["appVersion"] = sdk.appVersion; //app版本号
	params["platformType"] = sdk.platformType; //系统类型
	params["mac"] = ""; //设备mac地址
	params["imei"] = ""; //安卓设备imei
