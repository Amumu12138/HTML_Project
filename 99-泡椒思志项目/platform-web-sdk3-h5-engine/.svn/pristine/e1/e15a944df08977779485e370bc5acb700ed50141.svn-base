	});
};


function touchstart(e) {
	var touches = e.touches[0];
	sdk.oW = touches.clientX - sdk.shortcut.offsetLeft;
	sdk.oW = touches.clientY - sdk.shortcut.offsetTop;
	document.addEventListener("touchmove", defaultEvent, false);
}

function touchmove(e) {
	var touches = e.touches[0];
	var oLeft = touches.clientX - sdk.oW;
	var oTop = touches.clientY - sdk.oW;

	if (oLeft < 0) {
		oLeft = 0;
	}
	if (oTop < 0) {
		oTop = 0;
	}

	var rLeft = document.documentElement.clientWidth - sdk.shortcut.offsetWidth;
	if (oLeft > rLeft) {
		oLeft = rLeft;
	}

	var htop = document.documentElement.clientHeight - sdk.shortcut.offsetHeight;
	if (oTop > htop) {
		oTop = htop;
	}

	sdk.shortcut.style.left = oLeft + "px";
	sdk.shortcut.style.top = oTop + "px";
}

function touchend(e) {
	document.removeEventListener("touchmove", defaultEvent, false);
	var touches = e.changedTouches[0];

	var oLeft = touches.clientX - sdk.oW;
	var oTop = touches.clientY - sdk.oW;

    if (oLeft > (document.documentElement.clientWidth / 2)) {
        sdk.shortcut.style.right = "-25px";
        sdk.shortcut.style.left = "auto";

        //修改红点/气泡消息位置
        $("#red-dot").css("left", "0px");
        $("#float-tip").css("left", "-5px");
        var hasLeftTooltip =  document.getElementById("left-tooltip");
        if(hasLeftTooltip) {
            var leftText = $("#left-tooltip-text")[0].innerText;
            sdk.closeLeftTooltip();
            sdk.showRightTooltip(leftText);
        }
    } else {
        sdk.shortcut.style.left = "-25px";

        //修改红点/气泡消息位置
        $("#red-dot").css("left", "40px");
        $("#float-tip").css("left", "40px");
        var hasRightTooltip = document.getElementById("right-tooltip");
        if (hasRightTooltip) {
            var rightText = $("#right-tooltip-text")[0].innerText;
            sdk.closeRightTooltip();
            sdk.showLeftTooltip(rightText);
        }
    }
}

function defaultEvent(e) {
	e.preventDefault();
}

sdk.bindTouchEvent = function () {
	sdk.shortcut = document.getElementById("shortcut");
    sdk.shortcut.addEventListener("touchstart", touchstart, false);
	sdk.shortcut.addEventListener("touchmove", touchmove, false);
	sdk.shortcut.addEventListener("touchend", touchend, false);
};

//移除touch事件
sdk.unbindTouchEvent = function () {
	sdk.shortcut.removeEventListener("touchmove", touchmove, false);
	sdk.shortcut.removeEventListener("touchstart", touchstart, false);
	sdk.shortcut.removeEventListener("touchend", touchend, false);
};


//启动悬浮窗
sdk.enableFloatBox = function () {
	$("#shortcut").remove();
	var t = '<div id="shortcut"  style="width: 50px;height:50px;left: -25px;"  class="shortcut">';
	t += '<div class="flex" onclick="sdk.showNav()" id="iconDiv" style="width: 50px;height:50px;float:left;">';
	t += '<div id="ic-menu" class="r50" style="width: 50px;height:50px;"><span style="width: 50px;height:50px;" class="r50"></span></div>';
	t += "</div>";
	t += '<div  id="navDiv" style="display:none;width: auto;height:50px;border: 3px solid #232529;border-radius:25px;background-color:#44474e;float:left;">';
	t += "</div>";
	t += "</div>";
	$("body").append(t);

	//绑定touch事件
	sdk.bindTouchEvent();

	//初始化悬浮球菜单
	sdk.initFloatBox();
};

//初始化悬浮球
sdk.initFloatBox = function () {

	var params = {};
	params["appVersion"] = sdk.appVersion;
	params["channel"] = sdk.getItem("channel");
	params["channelGameId"] = sdk.getItem("channelGameId");
	params["channelId"] = sdk.channelId;
	params["gameId"] = sdk.gameInfo.gameId;
	params["os"] = sdk.platformType;
	params["platformId"] = sdk.platformId;
	params["platformType"] = sdk.platformType;
	params["sdkVersion"] = sdk.sdkVersion;
	params["tBrand"] = "h5";
	var url = sdk.buildURL(sdk.apiUrl + "openGame", params);
	sdk.httpGet(url, function (retData) {
		if (retData.code == sdk.SUCCESS) {
			var data = retData.data;

			var html = "";
			for (var i = 0; i < data.length; i++) {
				var url = "'" + data[i]["url"] + "'";
				html += '<div style="width: 25px;height:25px;margin-left:15px;float:left;" onclick="sdk.showUcBox(' + url + ')">';
				html += '<div  style="background:url(' + data[i]["iconUrl"] + ') no-repeat;width: 25px;height:25px;background-size: 100% auto;"></div>';
				html += '<div style="width: 25px;height:25px;color:white;font-size:12px;">' + data[i]["name"] + '</div>';
				html += '</div>';
            }
            $("#navDiv").css("width", (data.length * 44) + "px");
			$("#navDiv").append(html);

		} else {
			sdk.confirmDialog(retData.msg);
		}
	}, "json");
};

//显示悬浮菜单
sdk.showNav = function () {
	var r = $("#navDiv").css("display");
	if (r == "none") {

		sdk.unbindTouchEvent();

		$("#navDiv").css("display", "block");

		var leftW = $("#shortcut").css("left");
		var left = parseInt(leftW.replace("px", ""));

		if (left > 0 || isNaN(left)) { //图标在右边
			$("#iconDiv").css("float", "right");
			$("#shortcut").css("right", "0px");
		} else {
			$("#iconDiv").css("float", "left");
			$("#shortcut").css("left", "0px");
		}
		$("#shortcut").css("width", ($("#iconDiv").width() + $("#navDiv").width() + 6) + "px");
	} else {
		$("#navDiv").css("display", "none");
		$("#shortcut").css("width", "50px");

		sdk.bindTouchEvent();
	}

};


//打开用户中心
sdk.closeUcBox = function () {
	$("#showUcBox").remove();
};
sdk.showUcBox = function (ucurl) {

	$("#iconDiv").trigger("click");

	var param = {};
	param["channel"] = sdk.getItem("channel");
	param["channelId"] = sdk.channelId;
	param["udid"] = sdk.getUdid();
	param["gameId"] = sdk.gameInfo.gameId;
	param["channelGameId"] = sdk.getItem("channelGameId");
	param["uid"] = sdk.getItem("uid");
	param["token"] = sdk.getItem("sdkToken");
	param["sdkVersion"] = sdk.sdkVersion;
	param["appVersion"] = sdk.appVersion;
	param["imei"] = sdk.getUdid();
	param["mac"] = sdk.getUdid();
	param["os"] = "h5";
	param["tBrand"] = "h5";
	param["platformType"] = "h5"; //uc需要此参数判断来源
	param["platformId"] = sdk.platformId;
	param["ucHost"] = ucurl;

	var url = sdk.buildURL(sdk.apiUrl + "openUc", param);

	var ucCenterUrl = "";
	sdk.httpGet(url, function (retData) {
		if (retData.code == sdk.SUCCESS) {
			ucCenterUrl = retData.data;
			var loginHtml = '<div id="showUcBox" style="top:0px;" class="mask2 login-box2">';
			loginHtml += '<div class="r5" style="margin:0 auto;top:0px;-webkit-border-radius:0px;border-radius:0px;">';
			loginHtml += '<div class="login-head2"  style="text-align: right;"><span><i class="icon-cancel" onclick="sdk.closeUcBox()"></i></span></div>';
			loginHtml += '<div class="login-body" style="height:' + ($(window).height() - 40) + 'px !important;-webkit-overflow-scrolling: touch; overflow-y: scroll;">';
			loginHtml += '<iframe  width="' + $(window).width() + 'px !important" frameborder="no" scrolling="yes" border="0px" height="100%"   src="' + ucCenterUrl + '"></iframe>';
			loginHtml += '</div>';
			loginHtml += '</div>';
			loginHtml += '</div>';
			$("body").append(loginHtml);
		} else {
			sdk.confirmDialog(retData.msg);
		}
	}, "json");

};


//第三方登录
sdk.thirdLogin = function (type) {
	switch (type) {
		case 1: { //微信登录
			sdk.wxLogin(type);
			break;
		}
		case 2: { //QQ登录
			sdk.qqLogin(type);
			break;
		}
		case 3: { //新浪微博登录
			sdk.wbLogin(type);
			break;
		}
	}
};

