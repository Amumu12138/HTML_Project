//泡椒h5sdk-服务器端
var sdk = window.PJ_SDK || {};

sdk.debug = false;
sdk.platformId = 4;
sdk.channelId = -1;
sdk.platformType = "h5";

sdk.host = "https://h5.paojiao.cn";
//sdk.host = "http://localhost:8080";

sdk.apiUrl = sdk.host + "/api/";
sdk.mainUrl = sdk.host + '/main.html';
sdk.loginUrl = sdk.host + '/login.html';
sdk.thirdLoginUrl = sdk.host + "/thirdLogin/login/";
sdk.thirdLoginToOpenIdUrl = sdk.host + "/thirdLogin/loginByOpenId/";
sdk.xieYiUrl = sdk.host + "/xieyi.html";

sdk.findPwdUrl = 'https://member.paojiao.cn/retrievePassword?os=h5';

sdk.navInfo = {};
sdk.gameInfo = {};

sdk.SUCCESS = 1;
sdk.ERROR = 0;


sdk.appVersion = "1.0";
sdk.sdkVersion = "1.0.0";

sdk.shortcut = {};
sdk.oW = 0;
sdk.oH = 0;

sdk.init = function () {
    var channelGameId = sdk.getURLVar("channelGameId");
    var channel = sdk.getURLVar("channel");

    if (channelGameId != null && channelGameId != "null" && channelGameId != "") {
        sdk.setItem("channelGameId", channelGameId);
    }
    if (channel != null && channel != "null" && channel != "") {
        sdk.setItem("channel", channel);
    }

};



sdk.init2 = function () {
    var channelGameId = sdk.getURLVar("channelGameId");
    var channel = sdk.getURLVar("channel");
    var uid = sdk.getURLVar("uid");
    var sdkToken = sdk.getURLVar("sdkToken");
    var openid = sdk.getURLVar("openid");
    sdk.setItem("openid", openid);

    if (channelGameId != null && channelGameId != "null" && channelGameId != "") {
        sdk.setItem("channelGameId", channelGameId);
    }
    if (channel != null && channel != "null" && channel != "") {
        sdk.setItem("channel", channel);
    }

    if (uid != null && uid != "null" && uid != "") {
        sdk.setItem("uid", sdk.getURLVar("uid"));
    }
    if (sdkToken != null && sdkToken != "null" && sdkToken != "") {
        sdk.setItem("sdkToken", sdk.getURLVar("sdkToken"));
    }
};


sdk.init3 = function (channelGameId, channel) {
    var channelGameId = channelGameId;
    var channel = channel;

    if (channelGameId != null && channelGameId != "null" && channelGameId != "") {
        sdk.setItem("channelGameId", channelGameId);
    }
    if (channel != null && channel != "null" && channel != "") {
        sdk.setItem("channel", channel);
    }

};

sdk.log = function (title, data) {
    if (sdk.debug) {
        console.log("\n" + title + "\n" + JSON.stringify(data) + "\n");
    }
};

//生成udid
sdk.getUdid = function () {
    var u = sdk.getItem("udid");
    if (!u) {
        var gu = sdk.genUdid();
        sdk.setItem("udid", gu);
        return gu;
    } else {
        return u;
    }
};
sdk.s4 = function () {
    return (((1 + Math.random()) * 0x10000) | 0).toString(16).substring(1);
};
sdk.genUdid = function () {
    return (sdk.s4() + sdk.s4() + sdk.s4() + sdk.s4() + sdk.s4() + sdk.s4() + sdk.s4() + sdk.s4());
};


//加载loading页
sdk.initLoading = function (callback) {
    var isAmericaIp = sdk.getItem("isAmericaIp");
    if (isAmericaIp == "1") {
        $("#flashToAudit").show();
        setTimeout(function () {
            $("#flashToAudit").animate({
                opacity: 0
            }, 500, "swing", function () {
                $("#flashToAudit").remove();
                callback();
            });
        }, 1000);
        $("#flashToAuditBody").show();
    }
    if (isAmericaIp == "0" || isAmericaIp == "2") {
        $("#flash").show();
        $("#flash").append("<img src='/images/pj_background_flash_logo.png'/>");
        setTimeout(function () {
            $("#flash").animate({
                opacity: 0
            }, 500, "swing", function () {
                $("#flash").remove();
                callback();
            });
        }, 1000);
    }


};


//获取游戏详细
sdk.getGameInfo = function (isLogin, callback) {

    var params = {};
    params["channelGameId"] = sdk.getItem("channelGameId");
    params["channel"] = sdk.getItem("channel");
    params["udid"] = sdk.getUdid();
    params["isLogin"] = isLogin;
    sdk.api(params, "getGameInfo", function (data) {
        callback(data);
    });
};


sdk.closeLoginBox = function () {
    $("#loginBox").remove();
};
//打开登录框
sdk.loadLoginBox = function () {

    var loginHtml = '<div id="loginBox" class="mask login-box">';
    loginHtml += '<div class="r5">';
    loginHtml += '<div class="login-head"><img style="width: 220px;height:40px;" src="/images/titleIcon.png" />&nbsp;</div>';
    loginHtml += '<div class="login-body">';
    loginHtml += '<div>';
    loginHtml += '<div id="userBox" class="flex"><i class="icod-user"></i><input class="flex-list" id="userName" type="text" value="" placeholder="请输入账号"></div>';
    loginHtml += '<div id="pwdBox" class="flex"><i class="icod-lock"></i><input class="flex-list" id="password" type="password" value="" placeholder="请填写密码"></div>';
    loginHtml += '</div>';
    loginHtml += '<a href="javascript:;" style="background:#3997EE;width:50%;" class="btn" onclick="sdk.reg1()">一键注册</a><a href="javascript:;" style="width:50%;" class="btn" onclick="sdk.login()">登录</a>';

    loginHtml += '<div id="loginOption"   class="flex flex-x-between">';
    loginHtml += '<a href="javascript:;" onclick="sdk.showRegBox()" style="color:#999;">账号密码注册<a><a href="javascript:;" onclick="sdk.showFotPwdBox()" style="color:#999;">忘了密码?</a>';
    loginHtml += '</div>';
    if (sdk.isWeixin()) {
        loginHtml += '<fieldset class=""><legend>其他登录方式</legend></fieldset>';
    }


    loginHtml += '</div>';
    loginHtml += '<div class="login-mode">';
    loginHtml += '<ol class="flex active">';
    if (sdk.isWeixin()) {
        loginHtml += '<li class="flex-list list-show" onclick="sdk.thirdLogin(1)" title="微信扫码登录">';
        loginHtml += '<div class="r50"><i class="icod-wechat"></i></div>';
        loginHtml += '</li>';
    }


    /*loginHtml += '<li class="flex-list qq list-show" onclick="sdk.thirdLogin(2)" title="QQ登录">';
    loginHtml += '<div class="r50"><i class="icod-qq"></i></div>';
    loginHtml += '</li>';

    loginHtml += '<li class="flex-list sina list-show" onclick="sdk.thirdLogin(3)" title="新浪微博登录">';
    loginHtml += '<div class="r50"><i class="icod-sina"></i></div>';
    loginHtml += '</li>';*/

    loginHtml += '</ol>';
    loginHtml += '</div>';
    loginHtml += '</div>';
    loginHtml += '</div>';

    $("body").append(loginHtml);
};

