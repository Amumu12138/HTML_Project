var isEye = true;
sdk.updatePwdBoxEye = function () {
    if (isEye) {
        $("#update-pwd-box-eye").src = "/images/sdk2.0/pj_pw_invisible.png";
        isEye = false;
    } else {
        $("#update-pwd-box-eye").src = "/images/sdk2.0/pj_pw_visible.png";
        isEye = true;
    }
}
