//打开实名认证页面
sdk.showRealNameAuth = function (openRealNameAuth, uid, token) {

    sdk.setItem("uid", uid);
    sdk.setItem("sdkToken", token);

    var params = {};
    params["uid"] = uid;
    params["channel"] = sdk.getItem("channel");
    params["gameId"] = sdk.gameInfo.gameId;

    sdk.api(params, "getRealNameAuthUrl", function (retData) {

        sdk.closeRealNameBox(false);

        if (retData.code == 1) {
            var url = retData.data;

            var realNameAuth = '<div id="showRealNameBox" style="top:0px;" class="mask2 login-box2">';
            realNameAuth += '<div class="r5" style="margin:0 auto;top:0px;-webkit-border-radius:0px;border-radius:0px;">';
            if (openRealNameAuth == 1) {
                realNameAuth += '<div class="login-head2"  style="text-align: right;"><span><i class="icon-cancel" onclick="sdk.closeRealNameBox(true)"></i></span></div>';
            } else if (openRealNameAuth == 2) {
                realNameAuth += '<div class="login-head2"  style="text-align: right;"></div>';
            }
            realNameAuth += '<div class="login-body" style="height:' + ($(window).height() - 40) + 'px !important;-webkit-overflow-scrolling: touch; overflow-y: scroll;">';
            realNameAuth += '<iframe  width="' + $(window).width() + 'px !important" frameborder="no" scrolling="yes" border="0px" height="400px;"   src="' + url + '"></iframe>';
            realNameAuth += '</div>';
            realNameAuth += '</div>';
            realNameAuth += '</div>';
            $("body").append(realNameAuth);

        } else {
            sdk.confirmDialog(retData.msg);
            sdk.closeLoading();
        }

    });
};

