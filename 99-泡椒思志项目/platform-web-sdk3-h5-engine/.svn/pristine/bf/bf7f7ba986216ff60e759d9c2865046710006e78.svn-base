    $("#shortcut").remove();
    const shortcutHtml = `<div id="shortcut" style="width: 50px; height: 50px; left: 0px;" class="shortcut">
        <div class="flex" onclick="sdk.initFloatBox02()" id="iconDiv" style="width: 50px; height: 50px;float: left;">
