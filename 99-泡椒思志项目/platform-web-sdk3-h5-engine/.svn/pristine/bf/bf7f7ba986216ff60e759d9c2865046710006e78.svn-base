            break;
        case 1: //图片
            sdk.showOpenScreenImage("http://images.paojiao.cn/images/basicconfig/popupImg/1597800101684.png");
            break;
        case 2: //代金券
            sdk.showOpenScreenCoupon("/images/pj_background_flash.png");
            break;
        default:
            break;
    }
}

