                    <img style="width: 25px; height: 25px;" src="/images/sdk2.0/pj_onkey_tel.png"></img>
                    <h5 style="padding: 5px 0 0 5px;">手机登录</h5>
                </a>
            </div>
        </div>
        </div>
    </div>`;

    $("body").append(quickLoginHtml);
};

