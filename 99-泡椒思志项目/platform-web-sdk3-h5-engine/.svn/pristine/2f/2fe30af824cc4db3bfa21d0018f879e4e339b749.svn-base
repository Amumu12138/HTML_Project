package com.paojiao.sdk3.controller.thirdsdk.xiamenaotian;

import com.alibaba.fastjson.JSONObject;
import com.jfinal.aop.Aop;
import com.jfinal.kit.JsonKit;
import com.jfinal.kit.StrKit;
import com.paojiao.sdk3.common.StatusType;
import com.paojiao.sdk3.common.util.DateUtil;
import com.paojiao.sdk3.common.util.EncryptUtils;
import com.paojiao.sdk3.common.util.PjMap;
import com.paojiao.sdk3.common.util.SignUtil;
import com.paojiao.sdk3.controller.pay.PayStatus;
import com.paojiao.sdk3.controller.thirdsdk.ISDKVerifyListener;
import com.paojiao.sdk3.controller.thirdsdk.ItfSdk;
import com.paojiao.sdk3.controller.thirdsdk.SDKVerifyResult;
import com.paojiao.sdk3.model.PjCpGame;
import com.paojiao.sdk3.model.PjThirdSdkChannel;
import com.paojiao.sdk3.model.PjThirdSdkChannelGame;
import com.paojiao.sdk3.model.PjThirdSdkOrder;
import com.paojiao.sdk3.service.PjThirdSdkChannelGameService;
import com.paojiao.sdk3.service.PjThirdSdkChannelService;
import com.paojiao.sdk3.service.PjThirdSdkOrderService;
import org.apache.commons.lang.StringUtils;
import org.apache.log4j.Logger;

import javax.servlet.http.HttpServletRequest;
import java.util.HashMap;
import java.util.Map;

/**
 * 类描述：厦门傲天SDK
 *
 * @Author: jiangkun
 * @Date: 2020/06/29 14:42
 */
public class XiaMenAoTianSDK implements ItfSdk {
    private static final Logger log = Logger.getLogger(XiaMenAoTianSDK.class);
    private PjThirdSdkOrderService orderService = Aop.get(PjThirdSdkOrderService.class);
    private PjThirdSdkChannelGameService channelGameService = Aop.get(PjThirdSdkChannelGameService.class);
    private PjThirdSdkChannelService channelService = Aop.get(PjThirdSdkChannelService.class);

    @Override
    public void verify(PjThirdSdkChannel sdkChannel, PjThirdSdkChannelGame channelGame, PjCpGame game, String sdkToken, ISDKVerifyListener callback) {
        try {
            log.info("XiaMenAoTianSDK  客户端登录返回:" + sdkToken);
            if (StringUtils.isEmpty(sdkToken)) {
                log.info("XiaMenAoTianSDK 客户端登录返回为空");
                callback.onFailed(" verify failed. " + "XiaMenAoTianSDK 客户端登录返回为空");
                return;
            }
            JSONObject json = JSONObject.parseObject(sdkToken);
            final String account = json.getString("account");
            final String adult = json.getString("adult");
            final String op = json.getString("op");
            final String time = json.getString("time");
            final String extra = json.getString("extra");
            final String sign = json.getString("sign");
            if (StringUtils.isEmpty(account)) {
                log.info("XiaMenAoTianSDK account为空");
                callback.onFailed(" verify failed：XiaMenAoTianSDK:account为空");
                return;
            }
            if (StringUtils.isEmpty(adult)) {
                log.info("XiaMenAoTianSDK adult为空");
                callback.onFailed(" verify failed：XiaMenAoTianSDK:adult为空");
                return;
            }
            if (StringUtils.isEmpty(op)) {
                log.info("XiaMenAoTianSDK op为空");
                callback.onFailed(" verify failed：XiaMenAoTianSDK:op为空");
                return;
            }
            if (StringUtils.isEmpty(sign)) {
                log.info("XiaMenAoTianSDK sign为空");
                callback.onFailed(" verify failed：XiaMenAoTianSDK:sign为空");
                return;
            }
            if (StringUtils.isEmpty(extra)) {
                log.info("XiaMenAoTianSDK extra为空");
                callback.onFailed(" verify failed：XiaMenAoTianSDK:extra为空");
                return;
            }
            StringBuffer sf = new StringBuffer();
            sf.append(account).append(adult).append(op).append(extra).append(time)
                    .append(channelGame.getSignKey());

            log.info("XiaMenAoTianSDK.verify-加密参数： " + sf.toString());
            String signStr = SignUtil.md5(sf.toString());
            log.info("XiaMenAoTianSDK.verify-加密结果为： " + signStr.toLowerCase());

            if (!sign.equals(signStr.toLowerCase())) {
                callback.onFailed(sdkChannel.getSdkCode()
                        + " XiaMenAoTianSDK verify failed：验证签名错误");
                return;
            } else {
                log.info("XiaMenAoTianSDK 验证sign成功");
                callback.onSuccess(new SDKVerifyResult(true, account, null, null, ""));
                return;
            }
        } catch (Exception e) {
            e.printStackTrace();
            callback.onFailed(sdkChannel.getSdkCode()
                    + " verify execute failed. the exception is "
                    + e.getMessage());
        }
    }

    @Override
    public void orderCallBack(PjMap<String, String> params, HttpServletRequest request, ISDKVerifyListener callback) {
        log.info("XiaMenAoTianSDK orderCallBack:" + JsonKit.toJson(params));
        SDKVerifyResult vs = new SDKVerifyResult();
        Map<String,String> mapParmas = new HashMap<>();
        Map<String,String> map = new HashMap<>();

        String cporder = params.get("orderno");
        PjThirdSdkOrder iod = orderService.findOrderByOrderNo(cporder);
        //保存渠道需要的信息，返回给渠道
        mapParmas.put("sid",iod.getServerId());
        mapParmas.put("role_name",iod.getRoleName());
        String dataParams = JSONObject.toJSONString(mapParmas);
        try {
            PjThirdSdkChannelGame channelGame = channelGameService.findGameById(params.getToInt("channelGameId"));
            PjThirdSdkChannel channel = channelService.findChannelById(channelGame.getSdkChannelId());

            String sign = params.get("sign");
            try {
                StringBuffer sf = new StringBuffer();
                sf.append(params.get("account"))
                        .append(params.get("orderno"))
                        .append(params.get("number"))
                        .append(params.get("money"))
                        .append(params.get("time "))
                        .append(channelGame.getSignKey());
                log.info("XiaMenAoTianSDK.orderCallBack-加密参数:" + sf.toString());
                String newSign = SignUtil.md5(sf.toString());
                log.info("XiaMenAoTianSDK.orderCallBack-加密结果:" + newSign.toLowerCase());
                if (!sign.equals(newSign.toLowerCase())) {
                    log.error("XiaMenAoTianSDK ERROR Invalid sign original string:" + newSign + " your sign:" + sign);
                    map.put("status", "-1");
                    map.put("message","验签错误");
                    map.put("data","");
                    vs.setReturnMsg(JSONObject.toJSONString(map));
                    callback.onSuccess(vs);
                    return;
                }

                if (iod == null) {
                    log.error("ERROR:orer not found,orderNo:[" + cporder + "]");
                } else if (iod.getStatus() == PayStatus.PAY_SUCCESS.id) {// 已完成支付
                    log.error("重复回调,orderNo:[" + cporder + "]");
                    map.put("status", "1");
                    map.put("message","已完成支付");
                    map.put("data",dataParams);
                    vs.setReturnMsg(JSONObject.toJSONString(map));
                    callback.onSuccess(vs);
                    return;
                }
                // 真实收款
                Double amount = Double.valueOf(params.get("money"));
                // 实际收款金额不一致
                if (iod.getMoney() != amount.floatValue()) {
                    log.error("XiaMenAoTianSDK 收款金额与订单金额不符,orderNo:[" + cporder + "],订单金额："
                            + iod.getMoney() + ",实际收款金额：" + amount);
                    map.put("status", "-2");
                    map.put("message","金额不一致");
                    map.put("data","");
                    vs.setReturnMsg(JSONObject.toJSONString(map));
                    callback.onSuccess(vs);
                }
                log.info("+++++++++XiaMenAoTianSDK，完成支付....");
                orderService.finishOrderAndCallbackCp(cporder,
                        params.get("number"));

            } catch (Exception e) {
                map.put("status", "-5");
                map.put("message","系统错误");
                map.put("data","");
                vs.setReturnMsg(JSONObject.toJSONString(map));
                callback.onSuccess(vs);
                return;
            }
            map.put("status", "1");
            map.put("message","完成支付");
            map.put("data",dataParams);
            vs.setReturnMsg(JSONObject.toJSONString(map));
            callback.onSuccess(vs);
        } catch (Exception e) {
            map.put("status", "-5");
            map.put("message","系统错误");
            map.put("data","");
            vs.setReturnMsg(JSONObject.toJSONString(map));
            callback.onSuccess(vs);
            log.error("XiaMenAoTianSDK 充值回调请求异常！params:[" + JsonKit.toJson(params) + "]");
            e.printStackTrace();
        }
    }

    @Override
    public void getOrderNo(PjThirdSdkChannel sdkChannel, PjThirdSdkChannelGame channelGame, PjThirdSdkOrder order, PjMap<String, String> params, ISDKVerifyListener callback) {
        SDKVerifyResult result = new SDKVerifyResult();
        String time = DateUtil.timeStamp();
        StringBuffer sf = new StringBuffer();
        sf.append(order.getSdkUserId())
                .append(sdkChannel.getVkey())
                .append(order.getMoney().intValue())
                .append(order.getOrderNumber())
                .append(time)
                .append(channelGame.getSignKey());
        log.info("XiaMenAoTianSDK.getOrderNo-支付加密参数：" + sf.toString());
        String sign = EncryptUtils.md5(sf.toString());
        log.info("XiaMenAoTianSDK.getOrderNo-支付加密结果：" + sign);
        result.setExtension(sign.toLowerCase() + "_" + time + "_" + sdkChannel.getVkey());
        callback.onSuccess(result);
    }
}
