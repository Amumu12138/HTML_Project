	<style type="text/css">
		.icon-pjpay:before {
			width: 20px;
			height: 30px;
			content: "";
			background: url('/images/paojiao.jpg') no-repeat;
			background-size: 100% auto;
			display: table-cell;
			vertical-align: middle;
			position: relative;
			top: 10px;
		}
		body {
			margin: 0px;
		}

	</style>
</head>

<body>
<!--选择支付框-->
<div id="isLoadShow" style="display: none">
<div id="payBox-02" class="bg000"></div>
<div id="payBox-02-img" class="img-float"></div>
<div id="payBox-02-div" class="iframe-css">
</div>
</div>


<!--二维码-->
<div id="loadPayCode">
	<div id="imgBack">
	<div id="markedWords"><span>扫码支付</span></div>
	<div><img id="payCodeImg"></img></div>
	<div id="closePayCode"><button id="closePayCode-btn">返回游戏</button></div>
	</div>
</div>

<!--防沉迷弹框 【健康提示】 -->
<div id="addiction_Back">
	<div id="addiction_imgBack">
		<div id="addiction_Title">提示</div>
		<div id="addiction_Hint"><span></span></div>
	</div>
</div>

</body>
    <script type="text/javascript">
		//初始化
		sdk.init2();
		try {
			var channel = sdk.getItem("channel");
			var channelGameId = sdk.getItem("channelGameId");
			//保存微信openid
            var _urlParmas = pjapi.getURLParams();
			if (_urlParmas.uc_openid ==null || _urlParmas.uc_openid == ""){
				window.history.pushState({}, "", "https://h5.paojiao.cn/login.html?channelGameId=" + channelGameId + "&channel=" +
						channel);
			}else{
				sdk.setItem("wxOpenId",_urlParmas.uc_openid);
			}
		} catch (e) {
			console.info(e);
		}
		//页面主方法
		function start() {
			//获取游戏信息
			sdk.getGameInfo("false", function (ret) {
				if (ret.code == sdk.SUCCESS) { //成功
					sdk.gameInfo = ret.data;
					if (sdk.gameInfo.channelGameId == 10941){ //10941 游戏Id 做特殊处理
						$(document).attr("title", "客服中心");
					}else {
						var gameName = sdk.gameInfo.gameName;
						$(document).attr("title", gameName);
					}
					//加载游戏
					loadGame(sdk.gameInfo);

					//开始消息监听
					startEventListener();

					//显示开屏
					sdk.showOpenScreen();

					//上报在线
					startReportOnline(sdk.getItem("uid"),sdk.getItem("channel"),sdk.gameInfo.gameId);

					//注册退游弹窗事件
					callHistory();
				} else {
					sdk.confirmDialog(ret.msg);
				}
			});
		}

		//加载游戏
		function loadGame(gameInfo) {
			var orientation = gameInfo.orientation;
			var gameUrl = gameInfo.gameUrl;
			gameUrl = sdk.setURLVar(gameUrl, "sdkToken", sdk.getItem("sdkToken"));
			gameUrl = sdk.setURLVar(gameUrl, "uid", sdk.getItem("uid"));

			var realNameAuthStatus = sdk.setItem("realNameAuthStatus");
			if (realNameAuthStatus == "" || realNameAuthStatus == null) {
				realNameAuthStatus = 0;
			}

			gameUrl = sdk.setURLVar(gameUrl, "realNameAuthStatus", realNameAuthStatus);
			if (orientation == 0) { //横屏游戏
				$("body").append(
					'<div id="gameFrameDiv" style="width: 100%; height: 100%; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' +
					gameUrl +
					'" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: 100%; height: 100%;"></iframe></div>'
				);
				window.onorientationchange = function () {
					if (window.orientation == 90 || window.orientation == -90) {
						$("#gameFrameDiv").css({
							"left": $(window).width() - 20,
							"top": "30%"
						});
					}
				}
			} else { //竖屏游戏
                //刘海屏和水滴屏适配
                var hasIphoneX = window.innerHeight / window.innerWidth > 2 ? true : false;
                var offsetHeight = 0, offsetTop = 0;
                if (hasIphoneX) {
                    offsetHeight = -30;
                    offsetTop = 30;
                }

                $("body").append('<div id="gameFrameDiv" style="width: ' + $(window).width() + 'px; height: ' + ($(window).height() + offsetHeight) + 'px; position: relative; top: ' + offsetTop + 'px; left: 0px;">'
                    + '<iframe id="gameFrame" name="gameFrame" src="' + gameUrl + '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: ' + $(window).width() + 'px; height: ' + ($(window).height() + offsetHeight) + 'px;">'
                    + '</iframe></div>');
			}
			var isIp = sdk.getItem("isAmericaIp");
			if (isIp == "0" || isIp == "2"){
				sdk.enableFloatBox02();
			}
		}

		//开始消息监听
		function startEventListener() {
			window.addEventListener("message", receiveMessage, false);

			function receiveMessage(event) {
				sdk.log("host receive data", event.data);
				switch (event.data.method) {
                    case "PJ_loadPayBox": //拉起支付框
						sdk.loadPayBox02(event.data.param);
						break;
                    case "PJ_reportRoleInfo":  //上报玩家信息
						sdk.reportRoleInfo(event.data.param);
						break;
                    case "closePayBox": //关闭支付框页面
						sdk.closePayBox02();
						break;
                    case "logout":  //退出登录
						sdk.logout();
						break;
                    case "loadPubPay":  //拉起公众号支付
						sdk.loadPubPay(event.data.param);
						break;
                    case "openUc":  //打开用户中心菜单
						sdk.loadOpenUc(event.data.param);
						break;
                    default:
                        break;
				}
			}
		}

        //上报在线
		function startReportOnline(uid,channel,gameId){
			setInterval(function (){
				$.post("/onlineReport/report",{uid:uid,channel: channel,gameId:gameId},function(result){
					//返回处理
					if (result.data.event == 1){
						$("#addiction_Back").css("display","block");
						$("#addiction_Back").css("z-index","3");
						$("#addiction_Hint span").text("【健康提示】您今日的游戏时长已达到1.5小时，根据健康系统规则，您在一段时间内无法进入游戏，请合理安排游戏时间，5秒后自动退出！");
						setTimeout(function(){
							if (sdk.isWeixin()) {
								WeixinJSBridge.invoke('closeWindow', {}, function (res) {
								});
							} else {
								window.open("about:blank", "_self").close();
							}
							},5000);
					}else if (result.data.event == 2){
						$("#addiction_Back").css("display","block");
						$("#addiction_Back").css("z-index","3");
						$("#addiction_Hint span").text("【健康提示】当日22:00到次日8:00不允许在线，根据健康系统规则，您当前时间段无法进入游戏，请合理安排游戏时间，5秒后自动退出！");
						setTimeout(function(){
							if (sdk.isWeixin()) {
								WeixinJSBridge.invoke('closeWindow', {}, function (res) {
								});
							} else {
								window.open("about:blank", "_self").close();
							}
						},5000);
					}
				});
			},1000*60);
		}

		$(function () {
			start();
		});

        function onBridgeReady(payObj){
            WeixinJSBridge.invoke(
                'getBrandWCPayRequest', {
                    "appId":payObj.appId,
                    "timeStamp":payObj.timeStamp,
                    "nonceStr":payObj.nonceStr,
                    "package":payObj.package,
                    "signType":payObj.signType,
                    "paySign":payObj.paySign
                },
                function(res){
                    if(res.err_msg == "get_brand_wcpay_request:ok"){
                        sdk.confirmDialog("支付成功");
                    }else{
                        sdk.confirmDialog("支付失败");
                    }
                });
        }

        //拉起微信公众号支付
        function callWxPay(payObj){
            if (typeof WeixinJSBridge == "undefined"){
                if( document.addEventListener ){
                    document.addEventListener('WeixinJSBridgeReady', onBridgeReady, false);
                }else if (document.attachEvent){
                    document.attachEvent('WeixinJSBridgeReady', onBridgeReady(payObj));
                    document.attachEvent('onWeixinJSBridgeReady', onBridgeReady(payObj));
                }
            }else{
                onBridgeReady(payObj);
            }
        }


		window.addEventListener("popstate", function (e) {
			sdk.showOutGameBox();
		}, false);


		function callHistory() {
				var state = {
					title: "title",
					url: "#"
				};
				window.history.pushState(state, "title", "");
		}

		//注册退游弹出事件
		// function callHistory() {
        //     pushHistory();
        //     window.addEventListener("popstate", function (e) {
        //         sdk.showOutGameBox();
        //     }, false);
		//
        //     function pushHistory() {
        //         var state = {
        //             title: "title",
        //             url: "#"
        //         };
        //         window.history.pushState(state, "title", "");
        //     }
		//
        //     /**
        //      * 监听手机右滑后退返回游戏大厅功能实现
        //      **/
        //     let startX = 0, startY = 0;
        //     document.body.addEventListener("touchstart", function (e) {
        //         startX = e.changedTouches[0].pageX;
        //         startY = e.changedTouches[0].pageY;
        //     });
