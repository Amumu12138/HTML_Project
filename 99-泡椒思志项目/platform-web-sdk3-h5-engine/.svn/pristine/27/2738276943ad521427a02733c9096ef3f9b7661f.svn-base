$(function () {

    function isWeiXin(){
        var ua = window.navigator.userAgent.toLowerCase();
        if(ua.match(/MicroMessenger/i) == 'micromessenger'){
            return true;
        }else{
            return false;
        }
    }

    function isSafari() {
        var ua = window.navigator.userAgent.toLowerCase();
        if (ua.indexOf('applewebkit') > -1 && ua.indexOf('mobile') > -1 && ua.indexOf('safari') > -1 &&
            ua.indexOf('linux') === -1 && ua.indexOf('android') === -1 && ua.indexOf('chrome') === -1 &&
            ua.indexOf('ios') === -1 && ua.indexOf('browser') === -1) {
            return true;
        } else {
            return false;
        }
    }


    function showOtherPay(actualPrice,voucherPrice) {
        $("#goldPay").hide();
        $("#goldTxt").hide();

        $("#otherPay").show();
        $("#actualPrice1").html(actualPrice);
        if (voucherPrice > 0) {
            $("#originalPrice1").show();
        }else{
            $("#originalPrice1").hide();
        }
    }

    function showGoldPay(actualPrice) {
        $("#otherPay").hide();
        $("#actualPrice2").html(0);
        //$("#originalPrice2").show();
        $("#goldPay").show();
        $("#walletCostGold").html(actualPrice * 10);
        $("#walletCost").show();
    }

    function selectVoucher(){

        let deductMoney = $('.coupon_li.active').attr("data-deductMoney");
        let voucherId = $('.coupon_li.active').attr("data-voucherId");
        let payType = $("#payType").val();
        let userGold = parseInt($("#userGold").val());
        let orderPirce = $("#orderPirce").val();//订单金额
        console.log("orderPirce:" + orderPirce);
        console.log("deductMoney:" + deductMoney);
        console.log("voucherId:" + voucherId);
        console.log("payType:" + payType);
        console.log("userGold:" + userGold);

        if (deductMoney != undefined) {//选中了代金券
            //更新优惠券金额
            $("#deductMoney").html("￥-"+deductMoney);
            $("#voucherId").val(voucherId);
            $("#voucherPrice").val(deductMoney);

            //更新实际支付金额
            let actualPrice = parseInt(orderPirce - deductMoney);
            if (actualPrice < 0) {
                actualPrice = 0;
            }

            if (payType == 3) {//钱包支付
                //判断用户游币数量
                if (userGold < (actualPrice * 10)) {
                    console.log("游币不足3");
                    showGoldPay(actualPrice);
                    return;
                } else {
                    $("#goldTxt").hide();
                }
                //显示游币支付
                showGoldPay(actualPrice);

            } else {
                //显示其他支付
                showOtherPay(actualPrice,deductMoney);
            }
        } else {

            $("#deductMoney").html("");
            $("#voucherId").val("");
            $("#voucherPrice").val(0);

            if (payType == 3) {//钱包支付
                //显示游币支付
                showGoldPay(orderPirce);
            } else {
                //显示其他支付
                showOtherPay(orderPirce,0);
            }

        }
    }


    $('.pay_li ul').on('click', function () {
        $('.pay_li ul').removeClass("active");
        $(this).addClass("active");
        let payConfigId = $(this).attr("data-payConfigId");
        let payType = $(this).attr("data-payType");
        $("#payType").val(payType);
        $("#payConfigId").val(payConfigId);
        let orderPirce = parseInt($("#orderPirce").val());//订单金额
        let voucherPrice = parseInt($("#voucherPrice").val());//优惠券金额
        let userGold = parseInt($("#userGold").val());
        console.log("orderPirce:" + orderPirce);
        console.log("voucherPrice:" + voucherPrice);
        console.log("userGold:" + userGold);
        let actualPrice = orderPirce - voucherPrice;

        if (actualPrice < 0) {
            actualPrice = 0;
        }
        console.log("actualPrice:" + actualPrice);
        if (payType == 3) {
            //判断用户游币数量
            if (userGold < (actualPrice * 10)) {
                console.log("游币不足1");
                $("#goldTxt").show();
                showGoldPay(actualPrice);
                return;
            }
            //显示游币支付
            showGoldPay(actualPrice);
        } else {
            //显示其他支付
            showOtherPay(actualPrice,voucherPrice);
        }
    });


    $('.out').on('click', function () {
       /*  //微信浏览器和Safari浏览器内放弃支付，直接跳转返回游戏链接
         if (isWeiXin() || isSafari()) {
             let returnUrl = $("#returnUrl").val();
             if (returnUrl != null && returnUrl != '' ) {
                 top.location.href = returnUrl;
             }
         }else{
             backGame();
         }*/
        $("#isLoadShow").css("display","none");
    });

    //关闭支付页面
    $('.close').on('click', function () {
        $(".div3").show();
        $(".notSelect").addClass("active");
        $(".div1,.div2").hide();
    });


    //显示代金券页面
    $('.goto').on('click', function () {
        let canUseSize = $(this).attr("data-canUseSize");
        if (canUseSize == 0) {
            return;
        }
        $(".div2").show();//显示代金券页面
        $(".div1").hide();//关闭支付页面
    });

    //选择代金券
    $('.coupon_li').on('click', function () {
        //不可用代金券,无法选中
        if ($(this).attr("data-canUse") == "false") {
            return;
        }
        //放弃支付代金券，不能取消选中
        if ($(this).attr("data-isMaxDeductVoucher") == "1") {
            return;
        }

        if ($(this).hasClass("active")) {
            $(this).removeClass("active");
        } else {
            $('.coupon_li').removeClass("active");
            $(this).addClass("active");
        }
    });

    //选择代金券页面，返回
    $('.back1').on('click', function () {
        $(".div2").hide();//关闭代金券页面
        $(".div1").show();//显示支付页面
    });

    //继续支付
    $('.goto_pay').on('click', function () {
        $(".div1").show();
        $(".div3,.div2").hide();
        selectVoucher();
    });

    //代金券选择完成
    $('.red_button').on('click', function () {
        $(".div2").hide();//关闭代金券页面
        $(".div1").show();//显示支付页面
        selectVoucher();
    });

    $("#payBtn").click(function () {
        console.log("立即付款");
        let payConfigId = $("#payConfigId").val();
        if (payConfigId == "" || payConfigId == undefined) {
            open_box("请选择支付方式！");
            return;
        }

        let payType = $("#payType").val();
        if (payType == 3) {//游币支付,判断游币金额
            let orderPirce = parseInt($("#orderPirce").val());//订单金额
            let voucherPrice = parseInt($("#voucherPrice").val());//优惠券金额
            let userGold = parseInt($("#userGold").val());
            let actualPrice = orderPirce - voucherPrice;
            if (actualPrice < 0) {
                actualPrice = 0;
            }
            //判断用户游币数量
            if (userGold < (actualPrice * 10)) {
                console.log("游币不足2");
                open_box("游币不足，请先充值再进行支付");
                showGoldPay(actualPrice);
                return;
            }
        }

        var payParams = {};
        payParams["orderPirce"] = $("#orderPirce").val();//商品金额
        payParams["voucherPrice"] = $("#voucherPrice").val();//优惠券金额
        payParams["voucherId"] = $("#voucherId").val(); //优惠券ID
        payParams["payType"] = payType; //支付类型1.支付宝 2.微信 3.钱包
        payParams["payConfigId"] = payConfigId;//支付方式id,支付回调的时候使用
        payParams["puid"] = $("#puid").val();//公共平台ID
        payParams["uid"] = $("#uid").val();//业务平台ID
        payParams["orderNumber"] = $("#orderNumber").val();//H5订单
        payParams["userGold"] = $("#userGold").val();//用户游币数量
        payParams["returnUrl"] = $("#returnUrl").val();//回调地址
        console.info(payParams);

       /* sdk.httpPost(sdk.payUrl + "payTest", payParams, function (data) {*/
                $.ajax({
                    type: "POST",
                    data:payParams,
                    async:false,
                    //url: "http://localhost:8080/pay/getPayUrl",
                    url: "https://h5.paojiao.cn/pay/getPayUrl",
                    dataType: "json",
                    success: function(data){
                        if (data.code == 1){
                            console.info("跳转支付");

                            //关闭支付框页面
                            $("#isLoadShow").css("display","none");
                            $("#payBox-02-div").load(data.data,"",function () {
                                $("#isLoadShow").css("display","block");
                            });
                          //  window.open(data.data);
                        /*    $("#goToUrl").attr("href",data.data);
                            $("#goToUrl").attr("target","_parent");

                            $("#goToUrl span").click();*/

                           /* var form = document.createElement('form');
                            form.action = data.data;
                            form.target = '_blank';

                            form.method = 'POST';

                            document.body.appendChild(form);
                            form.submit();*/

                         /*   var al  =  document.getElementById("xxx");
                                al.onclick  =  function(e){
                                var winForsafari;
                                winForsafari = window.open("", "_blank");  //解决非用户触发情况下不生效问题
                                winForsafari.location.href = (data.data);
                                console.info("执行完成");
                                }*/
                        }else{
                            open_box(data.msg);
                        }
                    }
                });


     /*   });*/

       // $("#payGameForm").submit();

    });

    function goToPayShow(url) {
         $("#goToUrl").attr("href",url);
        document.getElementById("goToUrl").click();
    }

});
