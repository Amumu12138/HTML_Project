package com.paojiao.sdk3.controller.thirdsdk.shanghaiyizhi;

import com.alibaba.fastjson.JSONObject;
import com.jfinal.aop.Aop;
import com.jfinal.kit.JsonKit;
import com.paojiao.sdk3.common.util.PjMap;
import com.paojiao.sdk3.common.util.SignUtil;
import com.paojiao.sdk3.common.util.SignUtil2;
import com.paojiao.sdk3.controller.pay.PayStatus;
import com.paojiao.sdk3.controller.thirdsdk.*;
import com.paojiao.sdk3.model.PjCpGame;
import com.paojiao.sdk3.model.PjThirdSdkChannel;
import com.paojiao.sdk3.model.PjThirdSdkChannelGame;
import com.paojiao.sdk3.model.PjThirdSdkOrder;
import com.paojiao.sdk3.service.PjThirdSdkChannelGameService;
import com.paojiao.sdk3.service.PjThirdSdkChannelService;
import com.paojiao.sdk3.service.PjThirdSdkOrderService;
import org.apache.commons.lang.StringUtils;
import org.apache.log4j.Logger;

import javax.servlet.http.HttpServletRequest;
import java.net.URLDecoder;
import java.net.URLEncoder;
import java.util.HashMap;
import java.util.Map;

/**
 * 类描述：上海倚智-方块游戏 SDK
 *
 * @Author: jiangkun
 * @Date: 2020/09/18 15:57
 */
public class ShangHaiYiZhiSDK implements ItfSdk {
    private static final Logger log = Logger.getLogger(ShangHaiYiZhiSDK.class);
    private PjThirdSdkOrderService orderService = Aop.get(PjThirdSdkOrderService.class);
    private PjThirdSdkChannelGameService channelGameService = Aop.get(PjThirdSdkChannelGameService.class);
    private PjThirdSdkChannelService channelService = Aop.get(PjThirdSdkChannelService.class);

    @Override
    public void verify(PjThirdSdkChannel sdkChannel, PjThirdSdkChannelGame channelGame, PjCpGame game, String sdkToken, ISDKVerifyListener callback) {
        try {
            log.info("ShangHaiYiZhiSDK-verify  客户端登录返回:" + sdkToken);
            if (StringUtils.isEmpty(sdkToken)) {
                log.info("ShangHaiYiZhiSDK-verify 客户端登录返回为空");
                callback.onFailed("ShangHaiYiZhiSDK-verify failed: " + " 客户端登录返回为空");
                return;
            }
            JSONObject json = JSONObject.parseObject(sdkToken);
            final String cubeId = json.getString("cubeid");
            final String token = json.getString("token");
            final String appId = json.getString("appid");
            if (StringUtils.isEmpty(cubeId)) {
                log.info("ShangHaiYiZhiSDK-verify: cubeId为空");
                callback.onFailed("ShangHaiYiZhiSDK-verify failed: cubeId为空");
                return;
            }
            if (StringUtils.isEmpty(token)) {
                log.info("ShangHaiYiZhiSDK-verify: token为空");
                callback.onFailed("ShangHaiYiZhiSDK-verify failed: token为空");
                return;
            }
            if (StringUtils.isEmpty(appId)) {
                log.info("ShangHaiYiZhiSDK-verify: appId为空");
                callback.onFailed("ShangHaiYiZhiSDK-verify failed: appId为空");
                return;
            }
            //请求渠道需要的参数
            Map<String, String> signMap = new HashMap<>();
            signMap.put("cubeid", cubeId);
            signMap.put("token", token);
            signMap.put("appid", appId);
            String encryptionParams = SignUtil2.sortParam2(signMap) + channelGame.getPayKey();
            log.info("ShangHaiYiZhiSDK-verify: 加密参数：" + encryptionParams);
            //加密结果
            String sign = SignUtil2.md5(encryptionParams);
            signMap.put("sign", sign);
            String url = sdkChannel.getAuthUrl();
            StringBuffer sf = new StringBuffer();
            //用户信息获取Url
            sf.append(url).append(cubeId).append("/details");
            HttpAgent.newInstance().post(sf.toString(), signMap, new HttpFutureCallback() {
                @Override
                public void completed(String content) {
                    log.info("ShangHaiYiZhiSDK-verify:验证登录返回参数：" + content);
                    JSONObject json = JSONObject.parseObject(content);
                    if (json.getInteger("code") == 200) {
                        callback.onSuccess(new SDKVerifyResult(true, cubeId, "", null, ""));
                        return;
                    } else {
                        callback.onFailed(sdkChannel.getSdkCode() + " ShangHaiYiZhiSDK-verify failed：" + json.get("msg").toString());
                        return;
                    }

                }

                @Override
                public void failed(String err) {
                    callback.onFailed(sdkChannel.getSdkCode() + " ShangHaiYiZhiSDK-verify failed：验证签名错误");
                    return;
                }
            });
        } catch (Exception e) {
            e.printStackTrace();
            callback.onFailed(sdkChannel.getSdkCode()
                    + " verify execute failed. the exception is "
                    + e.getMessage());
        }
    }

    @Override
    public void orderCallBack(PjMap<String, String> params, HttpServletRequest request, ISDKVerifyListener callback) {
        log.info("ShangHaiYiZhiSDK.orderCallBack:" + JsonKit.toJson(params));
        SDKVerifyResult vs = new SDKVerifyResult();
        try {
            PjThirdSdkChannelGame channelGame = channelGameService.findGameById(params.getToInt("channelGameId"));
            String sign = params.get("sign");
            String ext = params.get("ext"); //我方订单号
            try {
                Map<String, String> callbackMap = new HashMap<>();
                callbackMap.put("orderid", params.get("orderid"));
                callbackMap.put("money", params.get("money"));
                callbackMap.put("status", params.get("status"));
                callbackMap.put("cubeid", params.get("cubeid"));
                callbackMap.put("appid", params.get("appid"));
                //A-Z 排序后待加密参数
                String verifyParam = SignUtil2.sortParam2(callbackMap) + channelGame.getPayKey();
                log.info("ShangHaiYiZhiSDK.orderCallBack 加密前参数：" + verifyParam);
                String againSign = SignUtil2.md5(verifyParam);
                //验证加密后sign是否一致
                if (!sign.equals(againSign)) {
                    log.error("ShangHaiYiZhiSDK ERROR Invalid sign original string:" + againSign + " your sign:" + sign);
                    vs.setReturnMsg("FAILURE");
                    callback.onSuccess(vs);
                    return;
                }
                String cporder = URLDecoder.decode(ext);
                PjThirdSdkOrder iod = orderService.findOrderByOrderNo(cporder);
                if (iod == null) {
                    log.error("ShangHaiYiZhiSDK.orderCallBack ERROR:orer not found,orderNo:[" + cporder + "]");
                } else if (iod.getStatus() == PayStatus.PAY_SUCCESS.id) {// 已完成支付
                    log.error("ShangHaiYiZhiSDK.orderCallBack 重复回调,orderNo:[" + cporder + "]");
                    vs.setReturnMsg("SUCCESS");
                    callback.onSuccess(vs);
                    return;
                }
                // 真实收款
                Double amount = Double.valueOf(params.get("money"))/ 100;
                // 实际收款金额不一致
                if (iod.getMoney() != amount.floatValue()) {
                    log.error("ShangHaiYiZhiSDK.orderCallBack 收款金额与订单金额不符,orderNo:[" + cporder + "],订单金额："
                            + iod.getMoney() + ",实际收款金额：" + amount);
                    vs.setReturnMsg("FAILURE");
                    callback.onSuccess(vs);
                    return;
                }
                log.info("+++++++++ShangHaiYiZhiSDK，完成支付....");
                orderService.finishOrderAndCallbackCp(cporder,
                        URLDecoder.decode(params.get("orderid")));
            } catch (Exception e) {
                log.error("ShangHaiYiZhiSDK.orderCallBack error:" + e.getMessage());
                vs.setReturnMsg("FAILURE");
                callback.onSuccess(vs);
                return;
            }
            vs.setReturnMsg("SUCCESS");
            callback.onSuccess(vs);
        } catch (Exception e) {
            vs.setReturnMsg("FAILURE");
            callback.onSuccess(vs);
            log.error("ShangHaiYiZhiSDK.orderCallBack 充值回调请求异常！params:[" + JsonKit.toJson(params) + "]");
            e.printStackTrace();
        }
    }

    @Override
    public void getOrderNo(PjThirdSdkChannel sdkChannel, PjThirdSdkChannelGame channelGame, PjThirdSdkOrder order, PjMap<String, String> params, ISDKVerifyListener callback) {
        try {
            Map<String, String> orderMap = new HashMap<>();
            orderMap.put("orderid", order.getOrderNumber());
            orderMap.put("money", String.valueOf(order.getMoney().intValue() * 100));
            orderMap.put("product", order.getGoodsName());
            orderMap.put("appid", channelGame.getSignKey());
            String signParam = SignUtil2.sortParam2(orderMap) + channelGame.getPayKey();
            log.info("ShangHaiYiZhiSDK-getOrderNo: 加密参数：" + signParam);
            String sign = SignUtil2.md5(signParam);
            log.info("ShangHaiYiZhiSDK-getOrderNo: 返回客户端参数：" + sign);
            SDKVerifyResult result = new SDKVerifyResult();
            result.setExtension(sign);
        } catch (Exception e) {
            log.info("ShangHaiYiZhiSDK-getOrderNo: ERROR：" + e.getMessage());
        }

    }

}
