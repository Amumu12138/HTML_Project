.button1 {
    position: relative;
    top: 30px;
    background-color: #FD0238;
    border-radius: 2px;
}

.loadingLoginBtn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 70px;
    height: 30px;
    border-radius: 5px;
    /* color: #ffffff; */
    background-color: white;
    border-style: solid;
    border-width: 1px;
    border-color: #727272;
    outline: none;
}

.loadingLoginBtn:active {
    /* background-color: #3e8e41;
    box-shadow: 0 5px #666; */
    transform: translateY(4px);
}

/*  头部标题*/
.header {
    padding: 80px;
    text-align: center;
    background: white;
}

.header h1 {
    font-size: 20px;
}

.header button {
    position: absolute;
    top: 50px;
    right: 15px;
    width: 100px;
    height: 50px;
}

/* 导航条*/
.topnav {
    overflow: hidden;
    background-color: #333333;
}

/* 导航条链接*/
.topnav a {
    float: left;
    display: block;
    color: #f2f2f2;
    text-align: center;
    padding: 14px 16px;
    text-decoration: none;
}

/* 链接颜色修改 :hover 选择鼠标在链接上面时*/
.topnav a:hover {
    background-color: #dddddd;
    color: black;
}

/* 创建两列*/
/* Left column 左侧栏*/
.leftcolumn {
    float: left;
    width: 75%;
}

/* 右侧栏*/
.rightcolumn {
    /* position: absolute; */
    float: right;
    width: 25%;
    background-color: #f1f1f1;
    padding-left: 20px;
}

/* 图像部分*/
.fakeimg {
    background-color: #aaaaaa;
    width: 100%;
    padding: 20px;
}

/* 文章卡片效果*/
.card {
    background-color: white;
    padding: 20px;
    /* margin-top: 20px; */
}

/* 列后面清除浮动*/
.row:after {
    content: "";
    display: table;
    clear: both;
}

/* 底部*/
.footer {
    padding: 20px;
    text-align: center;
    background: #dddddd;
    margin-top: 20px;
}

/* 响应式布局 屏幕尺寸小于800px时, 两列布局改为上下布局*/
@media screen and (max-width: 800px) {

    .leftcolumn,
    .rightcolumn {
        width: 100%;
        padding: 0;
    }
}

/* 响应式布局 屏幕尺寸小于400px时, 导航布局改为上下布局*/
@media screen and (max-width: 800px) {
    .topnav a {
        float: none;
        width: 100%;
    }
}

/* loading加载旋转动画 */
@keyframes rotate {
    0% {
        transform: rotate(0deg);
    }

    50% {
        transform: rotate(180deg);
    }

    100% {
        transform: rotate(360deg);
    }
}

.ball-clip-rotate>div {
    position: absolute;
    right: 85px;
    background-color: #fff;
    border-radius: 100%;
    margin: 2px;
    -webkit-animation-fill-mode: both;
    animation-fill-mode: both;
    border: 2px solid #000000;
    border-bottom-color: transparent;
    height: 20px;
    width: 20px;
    background: transparent !important;
    display: inline-block;
    -webkit-animation: rotate 0.75s 0s linear infinite;
    animation: rotate 0.75s 0s linear infinite;
}