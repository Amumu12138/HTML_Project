/** 泡椒SDK 2.0新增样式*/
/* loading加载旋转动画 */
@keyframes rotate {
    0% {
        transform: rotate(0deg);
    }

    50% {
        transform: rotate(180deg);
    }

    100% {
        transform: rotate(360deg);
    }
}

.ball-clip-rotate>div {
    position: absolute;
    right: 85px;
    background-color: #fff;
    border-radius: 100%;
    margin: 2px;
    -webkit-animation-fill-mode: both;
    animation-fill-mode: both;
    border: 2px solid #000000;
    border-bottom-color: transparent;
    height: 20px;
    width: 20px;
    background: transparent !important;
    display: inline-block;
    -webkit-animation: rotate 0.75s 0s linear infinite;
    animation: rotate 0.75s 0s linear infinite;
}

/*开屏*/
.open-screen {
    -o-border-radius: .25rem;
    -moz-border-radius: .25rem;
    -webkit-border-radius: .25rem;
    border-radius: .25rem;
}

.bg000{width:100%;height: 100%; background: #000; opacity: 0.5; z-index: 3;left:0px;top:0px; position: absolute;}
.imgbg{width:100%;height: 100%; overflow: hidden;z-index: 1;left:0px;top:0px; position: absolute;}

/* 竖屏 */
@media screen and (orientation: portrait) {
    .iframe_css{width:100%;height:74%; background: #f2f2f2;z-index:4;bottom:0px; position: absolute;}
    .shortcut{transform: scale(2.0);}
    .open-screen{transform: scale(2.0); margin-top: 10rem;}
    .imgfloat{position: absolute; top: 23%; left: 35%; width: 194px; height: 34px; z-index: 9999; background: url(/images/sdk2.0/pj_float_close_port.png) no-repeat;}
}

/* 横屏 */
@media screen and (orientation: landscape) {
    .iframe_css{width:60%;height: 100%; background: #f2f2f2;z-index:4;left:28px;top:0px; position: absolute;}
    .shortcut{transform: scale(0.8);}
    .open-screen{transform: scale(0.6); margin-top: -3rem;}
    .imgfloat{position: absolute; top: 8%; left: 65%; width: 34px; height: 194px; z-index: 9999; background: url(/images/sdk2.0/pj_float_close_landspace.png) no-repeat; transform: scale(0.5);}
}



