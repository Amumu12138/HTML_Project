<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<meta name="viewport"  content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no">
	<meta name="format-detection" content="telephone=no">
	<meta name="apple-mobile-web-app-capable" content="yes"/>
	<meta name="mobile-web-app-capable" content="yes"/>
	<meta name="full-screen" content="true"/>
	<meta name="screen-orientation" content="portrait"/>

	<title>游戏</title>

	<link href="/css/common.css" rel="stylesheet">
	<link href="/css/layout.css" rel="stylesheet">

	<script type="text/javascript" src="/js/jquery/jquery-1.9.1.min.js"></script>
	<script type="text/javascript" src="/js/jquery/jquery.md5.js"></script>
	<script type="text/javascript" src="/js/pj_api.js"></script>
	<script type="text/javascript" src="/js/pj_channel_sdk.js"></script>

	<style type="text/css">
		html,body{
			width:100%;
			height:100%
		}
		body {
			background: url(https://h5.paojiao.cn/images/huawei/hw_login_page.png) no-repeat center top;
			background-size: auto 100%;
		}

		#hw_loading_img {
			position: fixed;
			z-index: 9999;
			width: 100%;
			height: 100%;
			left: 0;
			top: 0;
			/* background: rgba(0, 0, 0, .8); */
			background: url(https://h5.paojiao.cn/images/huawei/hw_loading_flash_xdhmy.png) 0 0/100% 100% no-repeat;
		}
	</style>
	<script src="../../js/jquery/jquery.md5.js"></script>

</head>

<body>
<img id="hw_loading_img">

<script type="text/javascript">
	$(function(){

		//初始化渠道sdk
		pjChannelSdk.init(10890,"smxnh5_lswx_sm_001","1.0.0");
		console.info("初始化sdk成功......");
		setTimeout(function(){//定时器版
					console.info("四秒后关闭----");
					$("#hw_loading_img").css("display","none");//将图片的display属性设置为none
				},
				4000);//设置四千毫秒权即4秒
		//获取游戏信息
		pjChannelSdk.getGameInfo(function (retData) {
			console.info("getGameInfo return params +++"+JSON.stringify(retData));
			if(retData.code ==1){
				var gameName = retData.data.gameName;
				$(document).attr("title",gameName);
				var gameUrl = retData.data.gameUrl;
				var orientation = retData.data.orientation;

				//华为初始化SDK
				var params = {"appid":"102185103","forceLogin":1};
				HwFastappObject.gameLoginWithReal(JSON.stringify(params));
				HwFastappObject.onGameLoginWithRealResult = function onGameLoginWithRealResult(str) {
					console.info("---------onGameLoginWithRealResult code----------" + str.code + "---------onGameLoginWithRealResult msg----------" + str.data);
					//如果7004 和 2012 则认为是取消登录
					if (str.code == 7004 || str.code == 2012) {
						console.info("onGameLoginResult cancel");
						showDialogBox();
						//退出快游戏
						//system.postMessage("exitapp");
					}

					//华为登录时，需要传入服务端验证的参数
					var extension = JSON.stringify({
						"ts": str.gameUserData.ts,
						"playerId": str.gameUserData.playerId,
						"playerLevel": str.gameUserData.playerLevel,
						"gameAuthSign": str.gameUserData.gameAuthSign,
					});

					console.info("--------reuqest params--------:" + extension);
					//保存一下渠道用户ID
					pjChannelSdk["channelUserID"] = str.playerId;

					var realNameAuthStatus = "0";
					//randomNumStr 是不超过64位的随机数字符串
					var params = {"eventId":randomString(),"eventType":"GAMEBEGIN"}
					console.info("-------requestParmas-------:"+JSON.stringify(params));
					HwFastappObject.submitPlayerEvent(JSON.stringify(params));

					HwFastappObject.onSubmitPlayerEventResult = function onSubmitPlayerEventResult(str){
						console.info('AllDetail:' + JSON.stringify(str));
						if (str.code == 0){
							system.postMessage('AllDetail:' + JSON.stringify(str));
							system.postMessage('transactionId:' + str.transactionId);
							// transactionId=str.transactionId;
							realNameAuthStatus = "1";
						}
						if (str.code == 7016){
							system.postMessage('AllDetail:' + JSON.stringify(str));
							system.postMessage('transactionId:' + str.transactionId);
							// transactionId=str.transactionId;
							realNameAuthStatus = "1";
						}
					}

					//校验渠道token
					pjChannelSdk.getToken(extension, function (retData) {
						console.info("getToken return params-------：" + JSON.stringify(retData));
						if (retData.code == 1) {
							var gameParam = {};
							gameParam["uid"] = retData.data.userInfo.uid;
							gameParam["sdkToken"] = retData.data.userInfo.token;

							gameUrl = pjapi.buildURL(gameUrl, gameParam);

							console.log("===进入游戏===>>" + gameUrl);
							if (orientation == 0) {//横屏游戏
								$("body").append('<div id="gameFrameDiv" style="width: 100%; height: 100%; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' + gameUrl + '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: 100%; height: 100%;"></iframe></div>');
								window.onorientationchange = function () {
									if (window.orientation == 90 || window.orientation == -90) {
										$("#gameFrameDiv").css({"left": $(window).width() - 20, "top": "30%"});
									}
								}
							} else {//竖屏游戏
								$("body").append('<div id="gameFrameDiv" style="width: ' + $(window).width() + 'px;  height: ' + $(window).height() + 'px; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' + gameUrl + '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: ' + $(window).width() + 'px; height: ' + $(window).height() + 'px;"></iframe></div>');
							}

						} else {
							pjapi.confirmDialog(retData.msg);
						}
					});
				}
				//开启监听事件
				pjChannelSdk.startEventListener();

			}else{
				pjapi.confirmDialog(retData.msg);
				return;
			}

		});

	});

	function  receiveMessage(event){
		console.log(event.data);
		var params = event.data.param;

		if(event.data.method == 'PJ_loadPayBox'){//拉起支付
			console.log("调用订单获取接口");
			var payParam ={};

			payParam["channelGameId"]= pjChannelSdk.initData.channelGameId;
			payParam["appVersion"]= pjChannelSdk.initData.appVersion;
			payParam["channel"]=pjChannelSdk.initData.channel;
			payParam["sdkVersion"]=pjChannelSdk.sdkVersion;
			//渠道需要签名时的参数
			payParam["money"]=params["money"];
			payParam["uid"]=params["uid"];
			payParam["productName"]=params["goodsName"];
			payParam["roleId"]=params["roleId"];
			payParam["roleName"]=params["roleName"];
			payParam["serverId"]=params["serverId"];
			payParam["serverName"]=params["serverName"];
			payParam["description"]=params["description"];
			payParam["ext"]=params["ext"];
			payParam["cpOrderNo"]=params["cpOrderNo"];

			console.log("------------payParam--------------"+JSON.stringify(payParam));
			//生成融合sdk订单
			pjChannelSdk.getOrderNo(payParam,function (retData) {
				if(retData.code == 1){
					console.log("获取订单成功："+JSON.stringify(retData));
					var _d = retData.data.extension.split("_");
					var param1 = {
						"amount": retData.data.orderInfo.money+".00",    //商品金额
						"applicationID": "102185103",    //应用ID，在华为开发者联盟上获取的APP ID
						"country":"CN",
						"currency":"CNY",
						"url":"http://h5.paojiao.cn/api/payCallBack/10890",
						"productDesc": retData.data.orderInfo.goodsName,    //商品描述，该字段中不能包含特殊字符，包括# " & / ? $ ^ *:) \ < > , | % +
						"productName": retData.data.orderInfo.goodsName,    //商品名称，该字段中不能包含特殊字符，包括# " & / ? $ ^ *:) \ < > , | % +
						"requestId": retData.data.orderInfo.orderNumber,    //在支付前生成，用于唯一标识一次支付请求。支付平台在服务器回调接口中会原样返回requestId的值。该字段由字母和数字组成，必须在商户内唯一，用于唯一标识一个商户订单。
						"serviceCatalog": "X6",    //游戏设置为"X6"
						"merchantId": "41847624",    //华为开发者联盟上申请支付服务获取的“支付ID”
						"merchantName": "深圳泡椒思志信息技术有限公司",    //商户名称，开发者注册的公司名
						"sign": _d[0],    //签名，签名算法务必使用sha256算法。签名方式请参见“orderinfo参数说明”，
						//  示例代码请参见“签名校验示例代码”,网站地址https://developer.huawei.com/consumer/cn/service/hms/catalog/HuaweiJointOperation.html?page=hmssdk_jointOper_payment_sample_code
						//请尽可能使用示例代码源码来进行签名操作，减少因为签名方法不一致导致的调试不通，多谢
						"urlver": "2",    //固定值为2
						"sdkChannel": 3,    //游戏设置为3
						"publicKey": ""    //必须传入，但不参与签名，华为开发者联盟上申请支付服务获取的“支付公钥”
					}
					console.info("------this pay parmas:" + JSON.stringify(param1));
					var param2 = {"orderInfo": JSON.stringify(param1)}
					HwFastappObject.pay(JSON.stringify(param2));
					HwFastappObject.onPayResult = function onPayResult(str) {
						console.info("支付结果: " + str.code + ",message: " + str.data);
					}
				}else{
					pjapi.confirmDialog(retData.msg);
				}

			});
		}else if(event.data.method == 'PJ_reportRoleInfo'){//上报角色信息
			var json = {
				"rank": params["roleLever"],
				"role": params["roleName"],
				"area": params["roleServer"]
			};
			console.info("角色上报参数------------->" + JSON.stringify(json));
			HwFastappObject.savePlayerInfoWithReal(JSON.stringify(json));
			//json  华为渠道创角需要参数
			HwFastappObject.onSavePlayerInfoResult = function onSavePlayerInfoResult(str){
				console.info('---onSavePlayerInfoResult AllDetail:' + JSON.stringify(str));
				console.info('---Code---' + str.code);
			}
		}
	}



	function randomString(len) {
		len = len || 32;
		var $chars = 'ABCDEFGHJKMNPQRSTWXYZabcdefhijkmnprstwxyz2345678';    /****默认去掉了容易混淆的字符oOLl,9gq,Vv,Uu,I1****/
		var maxPos = $chars.length;
		var pwd = '';
		for (i = 0; i < len; i++) {
			pwd += $chars.charAt(Math.floor(Math.random() * maxPos));
		}
		return pwd;
	}


	function showDialogBox() {
		var html = '<div id="confirmDialog" class="mask dialog-box">';
		html += '<div class="r5">';
		html += "<div>" + '提示信息'+ "</div>";
		html += "<div>" + '是否退出游戏' + "</div>";
		html += '<div class="flex">';
		html += '<a href="javascript:;"  data-type="conLogin" class="flex-list unselect">' + '继续登录'+ "</a>";
		html += '<a href="javascript:;" data-type="outGame" class="flex-list unselect">' + '退出游戏' + "</a>";
		html += "</div></div></div>";
		$("body").append(html);
		$("#confirmDialog .flex a").click(function() {
			var type = $(this).attr("data-type");
			if (type == "conLogin") {
				location.reload();
			} else if (type == "outGame") {
				system.postMessage("exitapp");
			}
			$(this).parents("#confirmDialog").remove()
		})
	}









</script>
</body>
</html>
