<?xml version="1.0" encoding="UTF-8"?>
<project name="pj15-ad-stat" basedir="." default="deploy">

	<!--  准备资源文件 -->
	<property environment="env" />
	<!-- 所有工作环境的目录-->
	<property name="workspace.dir" location="/data/webapps/web/infox_h5_sdk/source" />
	<!-- 依赖项目路径 -->
	<property name="pj15.ad.stat" location="${workspace.dir}/infox_h5_sdk" />
	<!-- 当前要部署项目的webroot -->
	<property name="webroot.dir" value="${pj15.ad.stat}/WebRoot" />
	<!-- 当前要部署项目的源文件 -->
	<property name="src.dir" location="${pj15.ad.stat}/src" />
	<!-- 编译输出的classes -->
	<property name="class.dir" location="${pj15.ad.stat}/WebRoot/WEB-INF/classes" />
	<property name="lib.dir" location="${pj15.ad.stat}/WebRoot/WEB-INF/lib" />
	<!-- TOMCAT根目录 -->
	<property name="tomcat.home" value="/app/infox_h5_sdk_tomcat/" />
	
	<!-- 所有依赖的Jar文件 -->
	<path id="dependJars">
		<!-- 引用Tomcat/lib下的所有jar -->
		<fileset dir="${tomcat.home}/lib">
			<include name="**/*.jar" />
		</fileset>
		
		<fileset dir="${pj15.ad.stat}/WebRoot/WEB-INF/lib">
			<include name="**/*.jar" />
		</fileset>
		
	</path>
	
	
	<target name="compile-web">
		<javac srcdir="${pj15.ad.stat}/src" destdir="${class.dir}" classpathref="dependJars" includeantruntime="on">
				<compilerarg line="-encoding UTF-8 "/>   
		   </javac>
	</target>

	
	<!-- 将工程打包成一个jar包 -->
	<target name="deploy" depends="compile-web" description="将工程打成war包">
	
		<copy includeemptydirs="false" todir="${class.dir}" description="拷贝配置文件">
			<fileset dir="${pj15.ad.stat}/src" excludes="**/*.launch, **/*.java, config/*.*,WEB-INF/classes/*.*" />
		</copy>
	
		<war destfile="/data/webapps/web/infox_h5_sdk/war/ROOT.war" basedir="${webroot.dir}" webxml="${webroot.dir}/WEB-INF/web.xml"/>
		
	</target>
			   

</project>