package com.paojiao.sdk3.common;

/**
 * 缓存类型
 * @author zhouzhenyi
 * @date 2017年2月13日
 */
public enum CacheType {
	all("所有", 0),
	allGames("游戏", 1), 
	allSdkChannel("sdk渠道商",2),
	allSdkChannelGame("sdk渠道游戏", 3),
	allAdConfig("渠道广告配置", 4),
	allSdkGamePayEnv("渠道支付环境", 5),
	allPayconfig("支付配置", 6); 
	

	/**名字**/
	private String name;
	/**代码**/
	private Integer code;
	
	public String getName() {
		return name;
	}
	public void setName(String name) {
		this.name = name;
	}
	public Integer getCode() {
		return code;
	}
	public void setCode(Integer code) {
		this.code = code;
	}
	private CacheType(String name, Integer code) {
		this.name = name;
		this.code = code;
	}

}
