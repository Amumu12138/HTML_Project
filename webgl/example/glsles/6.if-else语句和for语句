//if-else 语句
int a;

if(a > 0 ) {
    a = 1;
}else {
    a = -1;
}

//for语言
//continue:直接跳到for循环的下一个循环 break:for循环终止执行
for (var i = 0; i < 20; i++) {
  ...
  if(i==15){
    continue;//进行下次循环，执行i=16对应的循环
  }
  ...
}

for (var i = 0; i < 20; i++) {
  ...
  if(i==15){
    break;//直接终止循环执行，i=16、17等后面的循环不再执行
  }
  ...
}
