{
    // include: 定义希望被编译文件的所有目录
    // **: 表示任意目录 *: 表示任意文件
    "include": [
        "./dev/**/*",
        "./pro/**/*"
    ],
    // exclude: 定义不需要编译的目录
    // 默认值: [“node_modules”, "bower_components", "jspm_packages"]
    "exclude": [
        "./config/**/*"
    ],
    // extends: 定义被继承的配置文件
    // 标识当前配置文件会自定包含config目录下base.json中的所有配置信息
    "extends": "./config/base",
    // files: 指定需要编译文件的列表
    "files": [
        "./dev/onde.ts",
        "./dev/two.ts",
        "./dev/three.ts"
    ]
}