<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="full-screen" content="true" />
    <meta name="screen-orientation" content="portrait" />
    <!-- 渠道商: 西安游心 -->
    <title>争渡三国</title>

    <link href="/css/common.css" rel="stylesheet">
    <link href="/css/layout.css" rel="stylesheet">

    <script type="text/javascript" src="/js/jquery/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="/js/jquery/jquery.md5.js"></script>
    <script type="text/javascript" src="/js/pj_api.js"></script>
    <script type="text/javascript" src="/js/pj_channel_sdk.js"></script>
    <script type="text/javascript" src="https://pv.sohu.com/cityjson?ie=utf-8"></script>
    <!-- 引入sdk -->
    <script src="https://www.yx9y.com/Public/static/xigusdk/xgh5sdk.js" + new Date().getTime()> </script>
    <style type="text/css">
        html,
        body {
            width: 100%;
            height: 100%
        }

        body {
            /*
               background: url(https://h5.infoxgame.com/images/duojiao_loading.png) no-repeat center top;
            */
            background-size: auto 100%;
        }
    </style>
</head>

<body>
    <!--<img id="qqy_loading_img">-->

    <script type="text/javascript">
        $(function () {

            //初始化渠道sdk
            pjChannelSdk.init("11053", "yxzbqh_XAYX_xh_001", "1.0.0");
            console.info("初始化sdk成功......");

            //获取游戏信息
            pjChannelSdk.getGameInfo(function (retData) {
                console.info("getGameInfo return params +++" + JSON.stringify(retData));
                if (retData.code == 1) {
                    var gameName = retData.data.gameName;
                    $(document).attr("title", gameName);
                    var gameUrl = retData.data.gameUrl;
                    var orientation = retData.data.orientation;

                    //模拟渠道登录成功/ 真实的渠道，这里是初始化渠道sdk、获取渠道登录回调信息登录
                    //初始化渠道sdk{
                    var _params = pjapi.getURLParams();
                    console.info("--------_params--------:" + JSON.stringify(_params));

                    //不同的渠道使用不同的拼接方式,示例使用泡椒h5sdk
                    var extension = JSON.stringify({
                        "channelExt": _params.channelExt,
                        "email": "83",
                        "game_appid": "DFD8D5DFA081F20CA",
                        "new_time": _params.new_time,
                        "loginplatform2cp": _params.loginplatform2cp,
                        "user_id": _params.user_id,
                        "sdklogindomain": _params.sdklogindomain,
                        "sdkloginmodel": _params.sdkloginmodel,
                        "sign": _params.sign,
                        "icon": _params.icon,
                        "nickname": _params.nickname
                    });

                    console.info("--------reuqest params--------:" + extension);
                    //保存一下渠道用户ID
                    pjChannelSdk["channelUserId"] = _params.user_id;
                    pjChannelSdk["channelExt"] = _params.channelExt;
                    pjChannelSdk["sdkloginmodel"] = _params.sdkloginmodel;

                    //校验渠道token
                    pjChannelSdk.getToken(extension, function (retData) {
                        console.info("getToken return params-------：" + JSON.stringify(
                            retData));
                        if (retData.code == 1) {
                            var gameParam = {};
                            gameParam["uid"] = retData.data.userInfo.uid;
                            gameParam["sdkToken"] = retData.data.userInfo.token;

                            gameUrl = pjapi.buildURL(gameUrl, gameParam);

                            console.log("===进入游戏===>>" + gameUrl);
                            if (orientation == 0) { //横屏游戏
                                $("body").append(
                                    '<div id="gameFrameDiv" style="width: 100%; height: 100%; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' +
                                    gameUrl +
                                    '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: 100%; height: 100%;"></iframe></div>'
                                );
                                window.onorientationchange = function () {
                                    if (window.orientation == 90 || window.orientation == -
                                        90) {
                                        $("#gameFrameDiv").css({
                                            "left": $(window).width() - 20,
                                            "top": "30%"
                                        });
                                    }
                                }
                            } else { //竖屏游戏

                                //苹果微信打开适配
                                if (pjapi.is_IOS() && pjapi.is_weixin()) {
                                    $("body").append(
                                        '<div id="gameFrameDiv" style="width: ' +
                                        $(window).width() + 'px;  height: ' + $(window)
                                        .height() +
                                        'px; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' +
                                        gameUrl +
                                        '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: ' +
                                        $(window).width() + 'px; height: ' + ($(window)
                                            .height()) +
                                        'px;"></iframe></div>');
                                } else {
                                    $("body").append('<div id="gameFrameDiv" style="width: ' +
                                        $(window).width() + 'px;  height: ' + $(window)
                                        .height() +
                                        'px; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' +
                                        gameUrl +
                                        '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: ' +
                                        $(window).width() + 'px; height: ' + $(window)
                                        .height() + 'px;"></iframe></div>');
                                }

                                //$("body").append('<div id="gameFrameDiv" style="width: ' + $(window).width() + 'px;  height: ' + $(window).height() + 'px; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' + gameUrl + '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: ' + $(window).width() + 'px; height: ' + $(window).height() + 'px;"></iframe></div>');

                            }

                        } else {
                            pjapi.confirmDialog(retData.msg);
                        }
                    });

                    //开启监听事件
                    pjChannelSdk.startEventListener();

                } else {
                    pjapi.confirmDialog(retData.msg);
                    return;
                }

            });

        });

        function receiveMessage(event) {
            console.log(event.data);
            var params = event.data.param;

            if (event.data.method == 'PJ_loadPayBox') { //拉起支付
                console.log("调用订单获取接口");
                var payParam = {};

                payParam["channelGameId"] = pjChannelSdk.initData.channelGameId;
                payParam["appVersion"] = pjChannelSdk.initData.appVersion;
                payParam["channel"] = pjChannelSdk.initData.channel;
                payParam["sdkVersion"] = pjChannelSdk.sdkVersion;
                //渠道需要签名时的参数
                payParam["money"] = params["money"];
                payParam["uid"] = params["uid"];
                payParam["productName"] = params["goodsName"];
                payParam["roleId"] = params["roleId"];
                payParam["roleName"] = params["roleName"];
                payParam["serverId"] = params["serverId"];
                payParam["serverName"] = params["serverName"];
                payParam["description"] = params["description"];
                payParam["ext"] = params["ext"];
                payParam["cpOrderNo"] = params["cpOrderNo"];
                payParam["channelExt"] = pjChannelSdk.channelExt;
                payParam["sdkloginmodel"] = pjChannelSdk.sdkloginmodel;

                console.log("------------payParam--------------" + JSON.stringify(payParam));
                //生成融合sdk订单
                pjChannelSdk.getOrderNo(payParam, function (retData) {
                    if (retData.code == 1) {
                        console.log("获取订单成功：" + JSON.stringify(retData));
                        var _d = retData.data.extension;
                        var payJson = {
                            "amount": parseInt(retData.data.orderInfo.money * 100), //金额,单位为分
                            "channelExt": pjChannelSdk.channelExt, //原样返回登录时透传的信息
                            "game_appid": "DFD8D5DFA081F20CA", //游戏编号：运营方为游戏分配的唯一编号
                            "props_name": retData.data.orderInfo.goodsName, //道具名称
                            "sdkloginmodel": pjChannelSdk.sdkloginmodel, //登陆时传递的参数
                            "trade_no": retData.data.orderInfo.orderNumber, //游戏透传参数(默认为游戏订单号,回调时候原样返回)
                            "user_id": pjChannelSdk.channelUserId, //运营方用户id
                            "sign": _d, //签名
                            "server_id": retData.data.orderInfo.serverId, //区服id
                            "server_name": retData.data.orderInfo.serverName, //区服名称
                            "role_id": retData.data.orderInfo.roleId, //角色id
                            "role_name": retData.data.orderInfo.roleName //角色名称
                        }

                        console.log("Amumu xianyouxin  payJson = ", payJson);
                        xgGame.h5paySdk(payJson, function (data) {
                            console.log("Amumu xianyouxin h5paySdk data = ", data);
                        });
                    } else {
                        pjapi.confirmDialog(retData.msg);
                    }

                });
            } else if (event.data.method == 'PJ_reportRoleInfo') {
                //上报角色信息
                var level = params["roleType"] == 0 ? 1 * 10000 + params["roleLever"] : params["roleLever"];

                var roleUrl = "https://h5.paojiao.cn/roleReport/xayxRoleReport";
                var roleParams = {
                    "user_id": pjChannelSdk.channelUserId, //运营方登陆时传递的user_id
                    "game_appid": "DFD8D5DFA081F20CA", //游戏编号:运营方为游戏分配的唯一编号
                    "server_id": params["serverid"], //区服id
                    "server_name": params["servername"], //区服名称
                    "role_id": params["roleid"], //角色id
                    "role_name": params["roleName"], //角色名称
                    "level": level, //角色等级(若有转生即: 转生 * 10000 + 角色等级)
                    "power": params["fightvalue"], //角色战力
                    "channelGameId": pjChannelSdk.initData.channelGameId
                };
                pjapi.httpPost(roleUrl, roleParams, function (data) {
                    console.log("Amumu xianyouxin data = ", data.sign);
                    var roleInfo = {
                        "user_id": pjChannelSdk.channelUserId, //运营方登陆时传递的user_id
                        "game_appid": "DFD8D5DFA081F20CA", //游戏编号:运营方为游戏分配的唯一编号
                        "server_id": params["serverid"], //区服id
                        "server_name": params["servername"], //区服名称
                        "role_id": params["roleid"], //角色id
                        "role_name": params["roleName"], //角色名称
                        "level": level, //角色等级(若有转生即: 转生 * 10000 + 角色等级)
                        "power": params["fightvalue"], //角色战力
                        "sign": data.sign //签名
                    }
                    console.log("Amumu xianyouxin jointCreateRole roleInfo = ", roleInfo);
                    xgGame.jointCreateRole(roleInfo);
                });


            }
        }
    </script>
</body>

</html>