sdk.hasOpenScreenText = false;
/**
 * @desc 显示开屏文字框
 * @param {string} title 弹窗标题
 * @param {string} content 弹窗内容
 */
sdk.showOpenScreenTextBox = function (title, content) {
    var newDate = (new Date().getMonth() + 1) + "-" + new Date().getDate();
    var date = sdk.getItem("open_text_date");
    if (newDate == date) return;

    const openScreenTextHtml = '<div id="open-screen-text-box" class="open-screen-mask" style="z-index: 2;">' +
        '<div class="open-screen">' +
        '<div class="open-screen-head">' +
        '<div class="flex">' +
        '<p>' + title + '</p>' +
        '<div id="open-screen-text-close-img" class="icon-jurisdiction-delete"></div>' +
        '</div>' +
        '</div>' +
        '<h5 class="open-screen-text">' + content + '</h5>' +
        '<div class="open-screen-bottom-flex">' +
        '<div id="open-screen-text-loginCheck" class="icon-check-box"></div>' +
        '<div class="open-screen-bottom-text">今日不再提示</div>' +
        '</div>' +
        '</div>' +
        '</div>';

    $("body").append(openScreenTextHtml);
    sdk.hasOpenScreenText = true;

    //注册监听事件
    $("#open-screen-text-close-img").click(function () {
        sdk.closeOpenScreenTextBox();
    });


    $("#open-screen-text-loginCheck").click(function () {
        sdk.updateCheckUrl("open-screen-text-loginCheck");
    });
};

var isOpenScreenFlag = false;
/**
 * @desc 更新勾选框资源
 */
sdk.updateCheckUrl = function (id) {
    if (!isOpenScreenFlag) {
        isOpenScreenFlag = true;
        $("#" + id + "").css("background", "url(/images/sdk2.0/1.png) no-repeat");
    } else {
        isOpenScreenFlag = false;
        $("#" + id + "").css("background", "url(/images/sdk2.0/2.png) no-repeat");
    }
};

/**
 * @desc 关闭开屏文字框
 */
sdk.closeOpenScreenTextBox = function () {
    $("#open-screen-text-box").remove();
    sdk.hasOpenScreenText = false;

    //判断是否勾选今日不再提示,若已勾选,则保存今日日期
    if (isOpenScreenFlag) {
        sdk.setItem("open_text_date", (new Date().getMonth() + 1) + "-" + new Date().getDate());
    }
};

/**
 * @desc 显示开屏图片
 * @param {Number} id 图片ID
 * @param {string} url 跳转路径
 * @param {string} imgUrl 图片路径
 */
sdk.showOpenScreenImage = function (id, url, imgUrl) {
    var newDate = (new Date().getMonth() + 1) + "-" + new Date().getDate();
    var date = sdk.getItem("open_image_date");
    if (newDate == date) return;

    const openScreenImageHtml = '<div id="open-screen-image-box-' + id + '" class="open-screen-mask" style="z-index: 1;">' +
        '<div class="open-screen" style="background: rgba(0,0,0,0);">' +
        '<img id="open-screen-image-img-' + id + '"  class="open-screen-image" src=' + imgUrl + '>' +
        '<div id="open-screen-image-close-img-' + id + '" class="icon-ad-close"></div>' +
        '<div class="open-screen-bottom-flex">' +
        '<div id="open-screen-image-loginCheck-' + id + '" class="icon-check-box"></div>' +
        '<div class="open-screen-bottom-text">今日不再提示</div>' +
        '</div>' +
        '</div>' +
        '</div>';

    $("body").append(openScreenImageHtml);

    //注册监听事件
    $("#open-screen-image-close-img-" + id).click(function () {
        sdk.closeOpenScreenImage(id);
    });

    $("#open-screen-image-img-" + id).click(function () {
        sdk.closeOpenScreenImage(id);
        var jumpUrl = sdk.concatJumpUrl(url);
        sdk.showHomeViewHtml(jumpUrl);
    });

    $("#open-screen-image-loginCheck-" + id).click(function () {
        sdk.updateCheckUrl("open-screen-image-loginCheck-" + id);
    });
};

/**
 * @desc 关闭开屏图片
 */
sdk.closeOpenScreenImage = function (id) {
    $("#open-screen-image-box-" + id).remove();

    //判断是否勾选今日不再提示,若已勾选,则保存今日日期
    if (isOpenScreenFlag) {
        sdk.setItem("open_image_date", (new Date().getMonth() + 1) + "-" + new Date().getDate());
    }
};

/**
 * @desc 显示开屏代金券
 * @param {Array} voucherList 代金券数组
 */
sdk.showOpenScreenCoupon = function (voucherList) {
    if (!voucherList || voucherList.length <= 0) return;
    var newDate = (new Date().getMonth() + 1) + "-" + new Date().getDate();
    var date = sdk.getItem("open_coupon_date");
    if (newDate == date) return;

    const openScreenCouponHtml = '<div id="open-screen-coupon-box" class="open-screen-mask" style="z-index: 3;">' +
        '<img class="open-screen-coupon-image" src="images/sdk2.0/pj_dialog_vouch_2.1.png">' +
        '<div id="open-screen-coupon-scroll" class="scroll" style="background: none; top: -10%; width: 84%;">' +
        '</div>' +
        '<div id="open-screen-coupon-close-img" class="coupon-icon-ad-close"></div>' +
        '</div>';

    $("body").append(openScreenCouponHtml);

    //添加代金券滑动列表
    for (var i = 0; i < voucherList.length; i++) {
        var coupon_text = "";
        var coupon_desc = "";
        var coupon_expiredEnd_text = voucherList[i].expiredEndDesc + "日前有效";
        var coupon_applicablRangeDesc_text = "适用范围:" + voucherList[i].expiredEndDesc;
        //满减规则；1有门槛，2无门槛
        if (voucherList[i].rule == 2) {
            coupon_text = "无门槛代金券";
            coupon_desc = "无门槛代金券";
        } else {
            coupon_text = "满" + voucherList[i].achieveMoney + "元可用";
            coupon_desc = "满" + voucherList[i].achieveMoney + "减" + voucherList[i].deduct + "代金券";
        }

        $("#open-screen-coupon-scroll").append(
            '<div class="scroll-open-screen-coupon-item">' +
            '<img src="images/sdk2.0/open_screen_coupon_bgImg.png">' +
            '<div class="open-screen-coupon-item-left-column">' +
            '<div class="flex-02">' +
            '<p>￥</p>' +
            '<p style="position: relative; top: -10px; left: -5px; font-size: 30px; font-weight: bold;">' + voucherList[i].deduct + '</p>' +
            ' </div>' +
            '<p>' + coupon_text + '</p>' +
            '</div>' +
            '<div class="open-screen-coupon-item-right-column">' +
            '<p style="font-size: 16px; font-weight: bold; color: #000000;">' + coupon_desc + '</p>' +
            '<p>' + coupon_expiredEnd_text + '</p>' +
            '<p>' + coupon_applicablRangeDesc_text + '</p>' +
            '</div>' +
            '</div>'
        );
    }

    //注册监听事件
    $("#open-screen-coupon-close-img").click(function () {
        sdk.closeOpenScreenCoupon();
    });
};

/**
 * @desc 关闭开屏代金券
 */
sdk.closeOpenScreenCoupon = function () {
    $("#open-screen-coupon-box").remove();

    sdk.setItem("open_coupon_date", (new Date().getMonth() + 1) + "-" + new Date().getDate());
};

/**
 * @desc 显示退游弹弹窗
 */
sdk.showOutGameBox = function () {
    sdk.initOutGame(function (data) {
        //判断接受的退游弹窗数据是否存在
        if(data && data.popupList && data.popupList.length >= 0) {
            var relatedArr = data.popupList[0].h5GameList ? data.popupList[0].h5GameList : null;
            sdk.showOutGameRelatedBox(relatedArr);
        }
    });
};

/**
 * @desc 显示退游关联游戏弹框
 * @param {Array} 关联游戏数组
 */
sdk.showOutGameRelatedBox = function (relatedArr) {
    sdk.closeOutGameRelatedBox();
    if (!relatedArr || relatedArr.length <= 0) return;

    const outGameRelatedHtml = '<div id="outGame-related-box" class="mask-02 login-box-02">' +
        '<div class="r5 outGame-frame">' +
        '<p style="font-size: 18px; color: #101027;">确定退出游戏吗?</p>' +
        '<p style="font-size: 14px; color: #919191;">玩过此游戏的玩家还玩过</p>' +
        '<img id="outGame-related-close-img" class="outGame-close-img" src="images/sdk2.0/pj_dialog_jurisdiction_delete.png">' +
        '<div id="outGame-related-flex" class="flex-02" style="height: 125px; width: 100%;">' +
        '</div>' +
        '<div style="position: relative; width: 100%; height: 20px;"></div>' +
        '<div class="flex-02">' +
        '<a class="flex-list-02 outGame-exit-btn" id="outGame-related-exit-btn">退出游戏</a>' +
        '<a class="flex-list-02 outGame-resume-btn" id="outGame-related-resume-btn">再玩一会</a>' +
        '</div>' +
        '</div>' +
        '</div>';

    $("body").append(outGameRelatedHtml);
    for (var i = 0; i < relatedArr.length; i++) {
        var gameName = relatedArr[i].gameName.length > 4 ? relatedArr[i].gameName.substring(0, 4) + "..." : relatedArr[i].gameName;

        $("#outGame-related-flex").append(
            '<a class="flex-list-02">' +
            '<img style="position: relative; top: 20px; width: 50px; height: 50px; border-radius: 50px;"  onclick="sdk.clickIconJumpResp(\'' + relatedArr[i].url + '\')" src=' + relatedArr[i].icon + ' >' +
            '<h5 style="position: relative; top: 30px; color: #919191;" >' + gameName + '</h5>' +
            '<button class="outGame-related-flex-btn" onclick="sdk.clickIconJumpResp(\'' + relatedArr[i].url + '\')">打开</button>' +
            '</a>'
        );
    }

    //注册按钮点击监听
    $("#outGame-related-close-img").click(function () {
        sdk.closeOutGameRelatedBox();
    });

    $("#outGame-related-resume-btn").click(function () {
        sdk.closeOutGameRelatedBox();
    });

    $("#outGame-related-exit-btn").click(function () {
        if (sdk.isWeixin()) {
            WeixinJSBridge.invoke('closeWindow', {}, function (res) {
            });
        } else {
            window.open("about:blank", "_self").close();
        }
    });
};

/**
 * @desc 点击图标跳转响应
 * @param url
 */
sdk.clickIconJumpResp = function (url) {
    if (url) window.open(url);
};
/**
 * @desc 关闭退游关联游戏弹框
 */
sdk.closeOutGameRelatedBox = function () {
    $("#outGame-related-box").remove();
};


/**
 * @desc 启动悬浮窗
 */
sdk.enableFloatBox02 = function () {
    // $("#shortcut").remove();
    const shortcutHtml = '<div id="shortcut" style="width: 50px; height: 50px; left: 0px;" class="shortcut">' +
        '<div class="flex" id="icondDiv" style="width: 50px; height: 50px;floatc: left;">' +
        '<div id="ic-menu" class="r50" style="width: 50px; height: 50px;">' +
        '<span style="width: 50px; height: 50px;" class="r50"></span>' +
        '</div>' +
        '</div>' +
        '<div id="navDiv" style="display:none; width: auto; height:50px; border: 3px; solid: #232529; border-radius: 25px; background-color:#44474e; float: left;"></div>' +
        '</div>';
    $("body").append(shortcutHtml);

    //延迟2秒后半隐藏
    setTimeout(function () {
        $("#shortcut").css("left", "-25px");
    }, 2000);

    //绑定touch事件
    sdk.bindTouchEvent();

    // sdk.showFloatTip(1);
    // sdk.enableFloatTip(true);
    // sdk.showLeftTooltip("123");
    //初始化悬浮球菜单
    sdk.initFloatTips(function (data) {
        sdk.showRedDot();
        sdk.showFloatTip(1);
        if (data.redDotStatus == 1) {
            sdk.enableRedDot(true);
        } else if (data.floatTipList) {
            sdk.enableFloatTip(true);
        }
        //定时请求气泡消息
        setInterval(function () {
            sdk.initFloatTips(function (data) {
                if (data.redDotStatus == 1) {
                    sdk.enableRedDot(true);
                } else if (data.floatTipList) {
                    sdk.enableRedDot(true);
                    if (data.floatTipList[0]) sdk.showLeftTooltip(data.floatTipList[0].content);
                }
            });
        }, data.reqSecond * 1000);
    });

    //注册监听事件
    document.getElementById("icondDiv").onclick = function () {
        sdk.initFloatBox02(function (data) {
            $("#shortcut").css("visibility", "hidden");
            sdk.enableRedDot(false);
            sdk.enableFloatTip(false);

            //var url = "https://platform.paojiao.cn/sdk2/index.html";
            sdk.showHomeViewHtml(data);
        });
    }
};

/**
 * @desc 显示主页面
 * @param {String} url 路径
 */
sdk.showHomeViewHtml = function (url) {
    const homeViewHtml = '<div id="home-mask-div" class="bg000"></div>' +
        '<div id="home-img" class="img-float"></div>' +
        '<div id="home-div" class="iframe-css">' +
        '<iframe src=' + url + ' style="width: 100%; height: 100%; background: #f2f2f2; border: 0px; overflow-x: hidden; border-radius: 15px 15px 0 0px;"></iframe>' +
        '</div>';

    $("body").append(homeViewHtml);

    document.getElementById("home-mask-div").onclick = function () {
        sdk.closeHomeViewHtml();
        $("#shortcut").css("visibility", "visible");
    }
};

sdk.closeHomeViewHtml = function () {
    $("#home-mask-div").remove();
    $("#home-div").remove();
    $("#home-img").remove();
};

/**
 * @desc 关闭悬浮球
 */
sdk.closeFloatBox02 = function () {
    $("#shortcut").remove();
};

/**
 * @desc 显示消息红点
 */
sdk.showRedDot = function () {
    const redDotHtml = '<div id="red-dot" class="r50" style="width:10px; height: 10px;  position: relative; top: -40px; left: 40px; background-color:#ff0000; visibility: hidden"></div>';
    $("#shortcut").append(redDotHtml);
};

/**
 * @desc 关闭消息红点
 */
sdk.closeRedDot = function () {
    $("#red-dot").remove();
};

sdk.hasRedDot = false;
/**
 * @desc 启用红点
 * @param {Boolean} hasFlag 是否标记
 */
sdk.enableRedDot = function (hasFlag) {
    if (hasFlag) {
        $("#red-dot").css("visibility", "visible");
        sdk.hasRedDot = true;
    } else {
        $("#red-dot").css("visibility", "hidden");
        sdk.hasRedDot = false;
    }
};

/**
 * @desc 显示悬浮红点提示消息
 * @param {number} num
 */
sdk.showFloatTip = function (num) {
    if (sdk.hasRedDot) return;
    const floatTipHtml = '<div id="float-tip" class="r50" style="width: 15px; height: 15px;  position: relative; top: -50px; left: 40px; background-color:#ff0000; font-size: 10px; color: #ffffff; text-align:center; visibility: hidden"> ' + num + '</div>';

    $("#shortcut").append(floatTipHtml);
};

/**
 * @desc 关闭消息红点
 */
sdk.closeFloatTip = function () {
    $("#float-tip").remove();
};

/**
 * @desc 启用消息红点
 * @param {Boolean} hasFlag 是否标记
 */
sdk.enableFloatTip = function (hasFlag) {
    if (hasFlag && !sdk.hasRedDot) {
        $("#float-tip").css("visibility", "visible");
    } else {
        $("#float-tip").css("visibility", "hidden");
    }
};

/**
 * @desc 显示左侧提示框
 * @param content
 */
sdk.showLeftTooltip = function (content) {
    const leftTooltipHtml = '<b id="left-tooltip" class="shortcut-tooltip">' +
        '<a class="shortcut-tooltip-arrow-external"></a>' +
        '<a id="left-tooltip-text" class="shortcut-tooltip-arrow-border"> ' + content + '</a>' +
        '</b>';
    $("#shortcut").append(leftTooltipHtml);

    //延迟2秒后半隐藏
    setTimeout(function () {
        $("#left-tooltip").css("visibility", "hidden");
    }, 2000);
};

/**
 * @desc 关闭左侧提示框
 */
sdk.closeLeftTooltip = function () {
    $("#left-tooltip").remove();
};

/**
 * @desc 显示右侧提示框
