        '<h5 style="color: #BABABA; text-align: left;">忘记密码?请与人工服务联系,提供手机号绑定的账号全称或所玩过的游戏信息。</h5>' +
        '</div>' +
        '</div>' +
        '</div>';

    $("body").append(mobileLoginVeriPwdHtml);
