<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="full-screen" content="true" />
    <meta name="screen-orientation" content="portrait" />
    <meta http-equiv="pragma" content="no-cache" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="cache" content="no-cache" />
    <meta http-equiv="expires" content="0" />

   <!-- Web App运行起来要像Native App，那么就要去掉Safari的一些默认控件，比如地址栏、状态栏之类的。-->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="format-detection" content="telephone=no">
    <meta name="viewport" content="width=device-width,initial-scale=1, minimum-scale=1.0, maximum-scale=1, user-scalable=no">

    <title>游戏登录</title>

    <link href="/css/common.css?20171011" rel="stylesheet">
    <link href="/css/common_v2.css?20171011" rel="stylesheet">
    <link href="/css/layout.css?20171011" rel="stylesheet">
    <script type="text/javascript" src="/js/jquery/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="/js/pj_api.js"></script>
    <script type="text/javascript" src="/js/pj_sdk_host_v1.js"></script>

</head>
<style>
    html,body{
        width:100%;
        height:100%
    }
    body {
        background-repeat:no-repeat; background-size:100% 100%;-moz-background-size:100% 100%;
        background-image:url(/images/sdk2.0/pj_flash.gif);
    }
</style>

<body>
<div id="flash"></div>
<div id="flashToAudit"></div>
<div id="flashToAuditBody"></div>
<!--泡椒微信公众号二维码-->
<div id="pjPubCode">
    <div class="imgBack">
        <div class="titleName" ><span>关注“泡椒游戏”公众号</span></div>
        <div><img id="codeImg"></img></div>
        <div class="closeCode" id="closeCode-btn"><button>关闭</button></div>
    </div>
</div>
<!--引导图展示-->
<div id="guideFigure">
    <div id="guideFigureImgBack">
        <div class="closeCode" id="guideFigure-btn"><button>关闭</button></div>
        <div><img id="guideFigureImg" src="/images/yindaotu.png"></img></div>
        <div id="introducer"><span>添加到主屏幕</span>（下次可以直接在桌面上打开游戏）</div>
    </div>
</div>



    <script type="text/javascript">
        sdk.init();
        /*sdk.guidanceDown(); //引导图方法*/
        var channelGameId = sdk.getItem("channelGameId");
        var channel = sdk.getItem("channel");
        var isEdition = sdk.getURLVar("isEdition");//IOS匹配IDFA专属字段
        //当前游戏做特殊处理，需要走IDFA匹配
        if (channelGameId == 10941 && isEdition ==null){
            window.location.href=sdk.loginUrl+"?channelGameId="+channelGameId+"&channel="+channel+"&isEdition=true";
        }
        var isAutoLogin = pjapi.getURLVar("isAutoLogin");

        sdk.getIsAudit(channelGameId, function (retData) {
            console.info(retData.code);

            //1 审核状态
            if (retData.code == "1") {
                sdk.initLoading(function () {
                    sdk.getGameInfo("true", function (ret) {
                        if (ret.code == sdk.SUCCESS) {//成功
                            sdk.gameInfo = ret.data;
                            if (sdk.gameInfo.channelGameId == 10941){ //10941 游戏Id 做特殊处理
                                $(document).attr("title", "客服中心");
                            }else {
                                var gameName = sdk.gameInfo.gameName;
                                $(document).attr("title", gameName);
                            }

                            sdk.autoLogin02();
                            startEventListener();
                        } else {
                            sdk.confirmDialog(ret.msg);

                        }
                    });
                });
            } else {
                sdk.initLoading(function () {
                    sdk.getGameInfo("true", function (ret) {
                        if (ret.code == sdk.SUCCESS) {//成功
                            sdk.gameInfo = ret.data;
                            var gameName = sdk.gameInfo.gameName;
                            $(document).attr("title", gameName);

                            if (isAutoLogin == "" || isAutoLogin == null){
                                sdk.autoLogin02();
                            }else{
                                sdk.showAccountLoginBox();
                            }
                            startEventListener();
                        } else {
                            sdk.confirmDialog(ret.msg);

                        }
                    });
                });
            }
        });

        function startEventListener() {
            window.addEventListener("message", receiveMessage, false);

            function receiveMessage(event) {
                switch (event.data.method) {
                    case "fotPwdCallback": {//关闭忘记密码
                        sdk.closeFotPwdBox();
                        sdk.loadLoginBox();
                        break;
                    }
                    case "realNameAuthCallback": {//实名认证回调
                        sdk.doRealNameAuthCallBack(event.data.code);
                        break;
                    }
                }
            }
        }

        $("#guideFigure-btn").click(function () {
            $("#guideFigure").css("display", "none");
        });
    </script>
</body>

</html>