//jq
$(function() {
 
$('.bottom_button button,.add_chat img,.red_button,.coupon_li,.button_div button,.code,.open_button button,.wx_pay,.alipay,.my_money,.open_body button,.draw_cash_button,.top_list li .right button,.red_money button,.title_id_card .close,.card_button,.flash_ico,.open_list,.open_li li,.navigation li,.coupon_li .button button,.gift_li .button button,.gift_copy,.bottom_div button,.bottom_button button,.j1,.j2,.confirm_address,.open_windows .left,.open_windows .right').on('touchstart',function(){
$(this).addClass('button_class');
});	

$('.bottom_button button,.add_chat img,.red_button,.coupon_li,.button_div button,.code,.open_button button,.wx_pay,.alipay,.my_money,.open_body button,.draw_cash_button,.top_list li .right button,.red_money button,.title_id_card .close,.card_button,.flash_ico,.open_list,.open_li li,.navigation li,.coupon_li .button button,.gift_li .button button,.gift_copy,.bottom_div button,.bottom_button button,.j1,.j2,.confirm_address,.open_windows .left,.open_windows .right').on('touchend',function(){
$(this).removeClass('button_class');
});	
	 
$('.open_box').on('click', function() {
$(".open_box").hide();
});
});
//end jq


function open_box(msg){
$(".open_box").hide();
$(".open_box").fadeIn(200);
$('.open_box').delay(1000).fadeOut(200);
document.getElementById("box_font").innerHTML = msg;
}

function formatDate(now,pattern) {
    var year = now.getFullYear();
    var month = now.getMonth() + 1;
    var date = now.getDate();
    var hour = now.getHours();
    var minute = now.getMinutes();
    var second = now.getSeconds();
   return pattern.replace("yyyy",year).replace("MM",(month > 9 ? month : '0' + month)).replace("dd",(date > 9 ? date : '0' + date))
        .replace("HH", (hour > 9 ? hour : '0' + hour)).replace("mm",(minute > 9 ? minute : '0' + minute) )
        .replace("ss",(second > 9 ? second : '0' + second));
}