<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="full-screen" content="true" />
    <meta name="screen-orientation" content="portrait" />
    <!-- 渠道商：宁波娱马  -->
    <title>争渡三国</title>

    <link href="/css/common.css" rel="stylesheet">
    <link href="/css/layout.css" rel="stylesheet">

    <script type="text/javascript" src="/js/jquery/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="/js/jquery/jquery.md5.js"></script>
    <script type="text/javascript" src="/js/pj_api.js"></script>
    <script type="text/javascript" src="/js/pj_channel_sdk.js"></script>
    <script type="text/javascript" src="https://staticjs.quickapi.net/static/lib/libQuickSDK_v2.js"></script>

    <style type="text/css">
        html,
        body {
            width: 100%;
            height: 100%
        }

        body {
            background-size: auto 100%;
        }
    </style>

</head>

<body>

    <script type="text/javascript">
        $(function () {

            //初始化渠道sdk
            pjChannelSdk.init(11072, "yxzbqh_NBBM_xh_001", "1.0.0");
            console.info("初始化sdk成功......");

            //获取游戏信息
            pjChannelSdk.getGameInfo(function (retData) {
                console.info("getGameInfo return params +++" + JSON.stringify(retData));
                if (retData.code == 1) {
                    var gameName = retData.data.gameName;
                    $(document).attr("title", gameName);
                    var gameUrl = retData.data.gameUrl;
                    var orientation = retData.data.orientation;

                    //调用渠道SDK 初始化方法
                    var productCode = '35926644731158352213704558575308'; //QuickSDK后台自动分配
                    var productKey = '80156603'; //QuickSDK后台自动分配
                    QuickSDK.init(productCode, productKey, true, function () {
                        console.log("init success");
                    })

                    QuickSDK.login(function (callbackData) {
                        var message;
                        if (callbackData.status) {
                            //不同的渠道使用不同的拼接方式,
                            var extension = JSON.stringify({
                                "uid": callbackData.data.uid,
                                "username": callbackData.data.username,
                                "token": callbackData.data.token,
                                "isLogin": callbackData.data.isLogin,
                                "channelId": callbackData.data.channelId
                            });
                            console.info("--------reuqest params--------:" + extension);

                            pjChannelSdk["uid"] = callbackData.data.uid;
                            pjChannelSdk["username"] = callbackData.data.username;
                            //校验渠道token
                            pjChannelSdk.getToken(extension, function (retData) {
                                console.info("getToken return params-------：" + JSON
                                    .stringify(retData));
                                if (retData.code == 1) {
                                    var gameParam = {};
                                    var params = pjChannelSdk.uid;
                                    gameParam["uid"] = retData.data.userInfo.uid;
                                    gameParam["sdkToken"] = retData.data.userInfo.token;

                                    gameUrl = pjapi.buildURL(gameUrl, gameParam);

                                    console.log("===进入游戏===>>" + gameUrl);
                                    if (orientation == 0) { //横屏游戏
                                        $("body").append(
                                            '<div id="gameFrameDiv" style="width: 100%; height: 100%; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' +
                                            gameUrl +
                                            '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: 100%; height: 100%;"></iframe></div>'
                                        );
                                        window.onorientationchange = function () {
                                            if (window.orientation == 90 || window
                                                .orientation == -90) {
                                                $("#gameFrameDiv").css({
                                                    "left": $(window)
                                                        .width() - 20,
                                                    "top": "30%"
                                                });
                                            }
                                        }
                                    } else { //竖屏游戏
                                        $("body").append(
                                            '<div idmeDiv" style="width: ' + $(
                                                window).width() + 'px;  height: ' +
                                            $(window).height() +
                                            'px; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' +
                                            gameUrl +
                                            '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: ' +
                                            $(window).width() + 'px; height: ' + $(
                                                window).height() +
                                            'px;"></iframe></div>');
                                    }

                                } else {
                                    pjapi.confirmDialog(retData.msg);
                                }
                            });
                            console.log('Quick Game:QuickSDK登录成功: uid=>' + callbackData.data
                                .uid);
                        } else {
                            console.log('Quick Game :QuickSDK登录失败:' + callbackData.data
                                .message);
                        }
                        //开启监听事件
                        pjChannelSdk.startEventListener();
                    })
                } else {
                    pjapi.confirmDialog(retData.msg);
                    return;
                }

            });

        });

        function receiveMessage(event) {
            console.log(event.data);
            var params = event.data.param;

            if (event.data.method == 'PJ_loadPayBox') { //拉起支付
                console.log("调用订单获取接口");
                var payParam = {};

                payParam["channelGameId"] = pjChannelSdk.initData.channelGameId;
                payParam["appVersion"] = pjChannelSdk.initData.appVersion;
                payParam["channel"] = pjChannelSdk.initData.channel;
                payParam["sdkVersion"] = pjChannelSdk.sdkVersion;


                payParam["money"] = params["money"];
                payParam["uid"] = params["uid"];
                payParam["productName"] = params["goodsName"];
                payParam["roleId"] = params["roleId"];
                payParam["roleName"] = params["roleName"];
                payParam["serverId"] = params["serverId"];
                payParam["serverName"] = params["serverName"];
                payParam["description"] = params["description"];
                payParam["ext"] = params["ext"];
                payParam["cpOrderNo"] = params["cpOrderNo"];

                console.log("------------payParam--------------" + JSON.stringify(payParam));
                //生成融合sdk订单
                pjChannelSdk.getOrderNo(payParam, function (retData) {
                    if (retData.code == 1) {
                        console.log("获取订单成功：" + JSON.stringify(retData));
                        // var _d = retData.data.extension.split("_");
                        // var extStr = decodeURIComponent(pjChannelSdk.extStr);
                        var orderInfo = new Object();
                        orderInfo.productCode = '35926644731158352213704558575308';
                        orderInfo.uid = retData.data.orderInfo.sdkUserId;
                        orderInfo.username = pjChannelSdk.username;
                        orderInfo.userRoleId = retData.data.orderInfo.roleId;
                        orderInfo.userRoleName = retData.data.orderInfo.roleName;
                        orderInfo.serverId = retData.data.orderInfo.serverId;
                        orderInfo.userServer = retData.data.orderInfo.serverName;
                        orderInfo.userLevel = 1;
                        orderInfo.cpOrderNo = retData.data.orderInfo.orderNumber;
                        orderInfo.amount = retData.data.orderInfo.money;
                        orderInfo.subject = retData.data.orderInfo.goodsName;
                        orderInfo.desc = retData.data.orderInfo.goodsName;
                        orderInfo.callbackUrl = '';
                        orderInfo.extrasParams = retData.data.orderInfo.orderNumber;
                        orderInfo.goodsId = '1';
                        orderInfo.count = 1;
                        orderInfo.quantifier = '个';
                        var orderInfoJson = JSON.stringify(orderInfo);
                        console.log('QiZhi Game:下单参数：' + orderInfoJson);
                        QuickSDK.pay(orderInfoJson, function (payStatusObject) {
                            console.log('QiZhi Game:下单通知' + JSON.stringify(payStatusObject));
                        })
                    } else {
                        pjapi.confirmDialog(retData.msg);
                    }

                });
                //上报角色信息
            } else if (event.data.method == 'PJ_reportRoleInfo') {
                console.info("--------PJ_reportRoleInfo params--------:" + JSON.stringify(params));
                var timestamp = pjapi.getTimestamp();
                var roleInfo = new Object();
                roleInfo.isCreateRole = false;
                roleInfo.roleCreateTime = timestamp;
                roleInfo.uid = pjChannelSdk.uid;
                roleInfo.username = pjChannelSdk.username;
                roleInfo.serverId = params["serverid"];
                roleInfo.serverName = params["servername"];
                roleInfo.userRoleName = params["roleName"];
                roleInfo.userRoleId = params["roleid"];
                roleInfo.userRoleBalance = params["roleMoney"];
                roleInfo.vipLevel = params["vip"];
                roleInfo.userRoleLevel = params["roleLever"];
                roleInfo.partyId = 1;
                roleInfo.partyName = '无';
                roleInfo.gameRoleGender = '';
                roleInfo.gameRolePower = '';
                roleInfo.partyRoleId = '';
                roleInfo.partyRoleName = '';
                roleInfo.professionId = '';
                roleInfo.profession = '';
                roleInfo.friendlist = '';
                var roleInfoJson = JSON.stringify(roleInfo);
                console.info("-------调用渠道角色上报接口请求参数-------" + roleInfoJson);
                QuickSDK.uploadGameRoleInfo(roleInfoJson, function (response) {
                    console.info("-------调用渠道角色上报接口------" + JSON.stringify(response));
                });
            }

        }
    </script>
</body>

</html>