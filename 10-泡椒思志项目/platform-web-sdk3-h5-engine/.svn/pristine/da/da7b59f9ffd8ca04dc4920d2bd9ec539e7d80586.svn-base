<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport"  content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="format-detection" content="telephone=no">
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="mobile-web-app-capable" content="yes"/>
    <meta name="full-screen" content="true"/>
    <meta name="screen-orientation" content="portrait"/>
    <!--  <meta name="full-screen" content="yes">
     <meta name="x5-fullscreen" content="true"> -->
    <title>游戏</title>

    <link href="/css/common.css?20171011" rel="stylesheet">
    <link href="/css/layout.css?20171011" rel="stylesheet">

    <script type="text/javascript" src="/js/jquery/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="/js/jquery/jquery.md5.js"></script>
    <script type="text/javascript" src="/js/pj_sdk_host.js"></script>

    <style type="text/css">
        .icon-pjpay:before{
            width:20px;
            height:30px;
            content:"";
            background:url('/images/paojiao.jpg') no-repeat;
            background-size: 100% auto;
            display:table-cell;
            vertical-align: middle;
            position:relative;
            top:10px;
        }


    </style>

</head>

<body>

<script type="text/javascript">
    sdk.init2();
    try {
        var channel =sdk.getItem("channel");
        var channelGameId =sdk.getItem("channelGameId");
        window.history.pushState({}, "", "https://h5.paojiao.cn/login.html?channelGameId="+channelGameId+"&channel="+channel);
    }catch (e) {
        console.info(e);
    }
    //页面主方法
    function start(){

        //获取游戏信息
        sdk.getGameInfo("false",function(ret){
            if(ret.code == sdk.SUCCESS){//成功
                sdk.gameInfo = ret.data;
                var gameName = sdk.gameInfo.gameName;
                $(document).attr("title",gameName);
                //加载游戏
                loadGame(sdk.gameInfo);

                //开始消息监听
                startEventListener();

            }else{
                sdk.confirmDialog(ret.msg);
                return;
            }

        });



    }


    //加载游戏
    function loadGame(gameInfo){
        var orientation = gameInfo.orientation;

        var gameUrl = gameInfo.gameUrl;
        gameUrl =  sdk.setURLVar(gameUrl,"sdkToken",sdk.getItem("sdkToken"));
        gameUrl =  sdk.setURLVar(gameUrl,"uid",sdk.getItem("uid"));
        var realNameAuthStatus = sdk.getItem("realNameAuthStatus");
        if(realNameAuthStatus == "" || realNameAuthStatus == null){
            realNameAuthStatus = 0;
        }

        gameUrl =  sdk.setURLVar(gameUrl,"realNameAuthStatus",realNameAuthStatus);


        if(orientation == 0){//横屏游戏

            $("body").append('<div id="gameFrameDiv" style="width: 100%; height: 100%; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' + gameUrl + '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: 100%; height: 100%;"></iframe></div>');

            window.onorientationchange = function () {
                if (window.orientation == 90 || window.orientation == -90) {
                    $("#gameFrameDiv").css({"left": $(window).width() - 20, "top": "30%"});
                }
            }

        }else{//竖屏游戏
            $("body").append('<div id="gameFrameDiv" style="width: ' + $(window).width() + 'px; height: ' + $(window).height() + 'px; position: relative; top: 0px; left: 0px;"><iframe id="gameFrame" name="gameFrame" src="' + gameUrl + '" frameborder="no" border="0px" marginwidth="0px" marginheight="0px" scrolling="auto" style="width: ' + $(window).width() + 'px; height: ' + $(window).height() + 'px;"></iframe></div>');
        }
        var isIp = sdk.getItem("isAmericaIp");
        if (isIp == "0"){
            sdk.enableFloatBox();
        }
    }


    //开始消息监听
    function startEventListener(){



        window.addEventListener("message", receiveMessage, false);

        function  receiveMessage(event){
            sdk.log("host receive data",event.data);
            switch (event.data.method) {

                // case "initLoading": {//加载loading页面
                // 	sdk.initLoading();
                // 	break;
                // }
                //
                // case "loadLoginBox": {//登录
                // 	sdk.loadLoginBox(event.data.param);
                // 	break;
                // }
                //
                // case "getToken": {//token验证
                // 	sdk.getToken(event.data.param);
                // 	break;
                // }

                case "PJ_loadPayBox": {//拉起支付框
                    sdk.loadPayBox(event.data.param);
                    break;
                }

                case "PJ_reportRoleInfo": {//上报玩家信息
                    sdk.reportRoleInfo(event.data.param);
                    break;
                }

                case "logout": {//退出登录
                    sdk.logout();
                    break;
                }

            }

        }
    }




    $(function(){

        start();


    });





</script>


</body>

</html>
