<!DOCTYPE html>
<html>

	<head>
		<meta charset="UTF-8">
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no">
		<meta name="format-detection" content="telephone=no">
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="full-screen" content="true" />
		<meta name="screen-orientation" content="portrait" />
		<title>SDK DEMO</title>

	    <script type="text/javascript" src="../../js/pj_sdk_client.js"></script>
		<script type="text/javascript" src="js/jquery-1.9.1.min.js"></script>
		<script src="../../js/jquery/jquery.md5.js"></script>
		<script src="../../js/pj_api.js"></script>
		<link rel="stylesheet" href="../../css/common.css">
		<link rel="stylesheet" href="../../css/layout.css">
		<link rel="stylesheet" href="../../css/style.css">

	</head>

	<body>

		<ul style="list-style: none">
			<li style="margin-top: 20px;">
				<input type="button" onclick="test_pay()" value="支付">
			</li>
			<li style="margin-top: 20px;">
				<input type="button" onclick="test_reportRoleInfo()" value="上报玩家角色信息">
			</li>
			<li style="margin-top: 20px;">
				<input type="button" onclick="logout()" value="退出">
			</li>
			<li style="margin-top: 20px;">
				<input type="button" onclick="md5()" value="md5加密">
			</li>
			<li style="margin-top: 20px;">
				<input type="button" onclick="logogo()" value="弹出框">
			</li>

            <li style="margin-top: 20px;">
				<input type="button" onclick="strSplit()" value="字符截取">
			</li>
		</ul>

	</body>

	<script type="text/javascript">

	 var pjsdk = window.YH_PJ_SDK_CLIENT;//获取sdk实例


		var  sdkToken = pjsdk.getURLVar("sdkToken");//用户登录token（通过登录回调获取）
	    var  uid  = pjsdk.getURLVar("uid");//泡椒用户id（通过登录回调获取）


	    var initData={
	    		uid:uid,//用户id，登录授权时传入。
	    		sdkToken:sdkToken//用户登录口令，登录授权时传入。
	     }


	    pjsdk.initSdk(initData);//初始化sdk



		//支付
		function test_pay() {

			//支付参数
			var params = {
				money: "0.01", //订单金额
				cpOrderNo: "cpOrderNo" + new Date().getTime(),
				roleId: "roleId123456",
				roleName: "角色名称123456",
				serverId: "serverId123456",
				serverName: "服务器名称123456",
				goodsName: "商品名称123456",
				description: "description123456",
				ext: "ext123456"
			};

			//拉起支付
			pjsdk.loadPayBox(params);

		}

		//上报玩家信息
		function test_reportRoleInfo() {

			var params = {
				roleid: '100', 			//角色ID
				roleName: '泡椒', 		//角色名称
				roleLever: "60", 		//角色等级
				roleMoney: '100', 		//角色剩余游戏币
				serverid: '100', 		//角色所在区服ID
				servername: '仙服1区', 	//角色所在区服名称，若无，用角色所在区服ID代替
				fightvalue: '120000', 	//战力
				vip: '2', 				//VIP等级
				time: '1551122330',		//当前时间戳 （10位数）
				extar: '拓展信息' 		//拓展信息
			}
			pjsdk.reportRoleInfo(params,function(data){
				  if(data.code == "1"){
				  	alert("上报成功");
				  }else{
				  	alert(data.msg);
				  }
			});
		}

		function logout() {
			pjsdk.logout();
		}

     function md5() {
       var  sign = $.md5("85657bfd1ff6e436f1aca41b534dd751c62");
       console.info("---------"+sign);
     }

     function logogo() {
         var html = '<div id="confirmDialog" class="mask dialog-box">';
         html += '<div class="r5">';
         html += "<div>" + '提示信息'+ "</div>";
         html += "<div>" + '是否退出游戏' + "</div>";
         html += '<div class="flex">';
         html += '<a href="javascript:;"  data-type="conLogin" class="flex-list unselect">' + '继续登录'+ "</a>";
         html += '<a href="javascript:;" data-type="outGame" class="flex-list unselect">' + '退出游戏' + "</a>";
         html += "</div></div></div>";
         $("body").append(html);
         $("#confirmDialog .flex a").click(function() {
             var type = $(this).attr("data-type");
             if (type == "conLogin") {
                 alert("继续游戏");
             } else if (type == "outGame") {
                 alert("退出游戏");
             }
             $(this).parents("#confirmDialog").remove()
         })
     }

     function strSplit() {
       var str = "71d4e70f6c5acddf4bba920b861c77e9_489_4895ea797ee3f996_{\\\"game\\\":\\\"djx\\\",\\\"appkey\\\":\\\"158796970671\\\",\\\"token\\\":\\\"366d641b1565d10528caa6d218d7d7e4\\\",\\\"channel\\\":\\\"0\\\",\\\"ext\\\":\\\"eyJmbGFnIjpudWxsLCJpc19yZWFsbmFtZSI6MCwiaXNfYWR1bHQiOjAsImFnZSI6MH0=\\\"";
		console.info("---------[0]---"+str.split("_")[0]);
		console.info("---------[1]---"+str.split("_")[1]);
		console.info("---------[2]---"+str.split("_")[2]);
		console.info("---------[3]---"+str.split("_")[3]);
		}

	</script>

</html>
